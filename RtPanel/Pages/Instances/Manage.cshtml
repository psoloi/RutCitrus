    // === 全服配置 (RM 管理协议 serversettings) ===
    let serverSettingsCache = [];
    async function loadServerSettings() {
        const body = document.getElementById('serverSettingsBody');
        body.innerHTML = '<div class="text-muted text-center py-4">正在加载全服配置...</div>';
        const resp = await fetch(`/api/instances/serversettings?serverKey=${encodeURIComponent(INSTANCE_ID)}`).then(r => r.json());
        if (!resp.success) {
            body.innerHTML = `<div class="alert alert-warning small mb-0">${escapeHtml(resp.message || '加载失败')}</div>`;
            return;
        }
        serverSettingsCache = resp.settings || [];
        renderServerSettings();
    }
    function renderServerSettings() {
        const body = document.getElementById('serverSettingsBody');
        if (serverSettingsCache.length === 0) {
            body.innerHTML = '<div class="text-muted text-center py-4">该实例没有可用的全服配置项</div>';
            return;
        }
        body.innerHTML = `<div class="row g-3">` + serverSettingsCache.map((s, i) => {
            const label = escapeHtml(s.label || s.key);
            const key = escapeHtml(s.key);
            let input;
            if (s.type === 'bool') {
                input = `<div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" id="ss_${i}" ${(s.value === 'true' || s.value === '1') ? 'checked' : ''} />
                        </div>`;
            } else if (s.type === 'enum') {
                const opts = (s.options || []).map(o =>
                    `<option value="${escapeHtml(o)}" ${o === s.value ? 'selected' : ''}>${escapeHtml(o)}</option>`).join('');
                input = `<select class="form-select form-select-sm" id="ss_${i}">${opts}</select>`;
            } else if (s.type === 'int') {
                input = `<input type="number" class="form-control form-control-sm" id="ss_${i}" value="${escapeHtml(s.value)}" />`;
            } else {
                input = `<input type="text" class="form-control form-control-sm" id="ss_${i}" value="${escapeHtml(s.value)}" />`;
            }
            return `<div class="col-md-6">
                        <div class="border rounded p-2">
                            <label class="form-label small mb-1 d-block">${label}
                                <code class="text-muted small">${key}</code></label>
                            ${input}
                        </div>
                    </div>`;
        }).join('') + `</div>`;
    }
    async function saveServerSettings() {
        const values = serverSettingsCache.map((s, i) => {
            const el = document.getElementById(`ss_${i}`);
            let val;
            if (s.type === 'bool') val = el.checked ? 'true' : 'false';
            else val = el.value;
            return { key: s.key, value: val };
        });
        const resp = await fetch('/api/instances/serversettings/save', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ serverKey: INSTANCE_ID, values })
        }).then(r => r.json());
        showStatus(resp.message || (resp.success ? '已保存' : '保存失败'), resp.success ? 'success' : 'danger');
        if (resp.success) loadServerSettings();
    }

