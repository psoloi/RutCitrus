    // --- 游戏规则 ---
    let gameruleCache = [];
    async function loadGamerules() {
        const body = document.getElementById('gamerulesBody');
        body.innerHTML = '<div class="text-muted text-center py-4">正在加载游戏规则...</div>';
        const resp = await rmManage('gamerules', 'get', '', '', false);
        if (!resp.success) {
            body.innerHTML = `<div class="alert alert-warning small mb-0">${escapeHtml(resp.message || '加载失败')}</div>`;
            return;
        }
        gameruleCache = resp.entries || [];
        renderGamerules();
    }
    function renderGamerules() {
        const body = document.getElementById('gamerulesBody');
        if (!gameruleCache.length) { body.innerHTML = '<div class="text-muted text-center py-4">没有可用的游戏规则</div>'; return; }
        body.innerHTML = '<div class="row g-2">' + gameruleCache.map((g, i) => {
            const v = (g.value ?? '').toString();
            let input;
            if (v === 'true' || v === 'false') {
                input = `<select class="form-select form-select-sm" id="gr_${i}">
                            <option value="true"${v === 'true' ? ' selected' : ''}>true</option>
                            <option value="false"${v === 'false' ? ' selected' : ''}>false</option>
                         </select>`;
            } else {
                input = `<input type="text" class="form-control form-control-sm" id="gr_${i}" value="${escapeHtml(v)}" />`;
            }
            return `<div class="col-md-6"><div class="border rounded p-2">
                        <label class="form-label small mb-1 d-block">${escapeHtml(g.name)}</label>${input}
                    </div></div>`;
        }).join('') + '</div>';
    }
    async function saveGamerules() {
        if (!gameruleCache.length) { showStatus('请先刷新游戏规则', 'warning'); return; }
        let ok = 0, fail = 0;
        for (let i = 0; i < gameruleCache.length; i++) {
            const el = document.getElementById(`gr_${i}`);
            if (!el) continue;
            const resp = await rmManage('gamerules', 'set', gameruleCache[i].name, el.value, false);
            if (resp.success) ok++; else fail++;
        }
        showStatus(`游戏规则已应用: 成功 ${ok} 项${fail ? `，失败 ${fail} 项` : ''}`, fail ? 'warning' : 'success');
    }

