        const resp = await rmManage('discover', 'discover', '', '', false);
        if (!resp.success) { showStatus(resp.message || '能力发现失败', 'danger'); return; }
        showStatus('已获取管理协议能力', 'success');
        showRmRaw(resp.raw || '(无返回)');
