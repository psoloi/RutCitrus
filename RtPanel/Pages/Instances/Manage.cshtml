    // === 自定义命令 ===
    let customCommands = [];
    async function loadCustomCommands() {
        const resp = await fetch(`/api/instances/custom-commands?id=${encodeURIComponent(INSTANCE_ID)}`).then(r => r.json());
        if (resp.success) {
            customCommands = resp.commands || [];
            renderCustomCommands();
        }
    }
    function renderCustomCommands() {
        const container = document.getElementById('customCommandList');
        if (customCommands.length === 0) {
            container.innerHTML = '<div class="text-muted small p-2">暂无自定义命令</div>';
            return;
        }
        container.innerHTML = customCommands.map((c, i) => `<div class="d-flex justify-content-between align-items-center border-bottom p-2">
            <div class="flex-grow-1">
                <strong class="small">${escapeHtml(c.name)}</strong>
                <code class="text-muted small d-block">${escapeHtml(c.command)}</code>
            </div>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-info" onclick="runCustomCommand(${i})" title="执行">▶</button>
                <button class="btn btn-outline-danger" onclick="removeCustomCommand(${i})" title="删除">✕</button>
            </div>
        </div>`).join('');
    }
    function addCustomCommand() {
        const name = document.getElementById('pm_cc_name').value.trim();
        const command = document.getElementById('pm_cc_command').value.trim();
        if (!name || !command) { showStatus('请输入名称和命令', 'warning'); return; }
