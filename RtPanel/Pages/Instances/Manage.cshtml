@page "{id?}"
@model RtPanel.Pages.Instances.ManageModel
@{
    ViewData["Title"] = "实例管理";
}

<div class="instances-manage-page">
    <!-- 顶部导航 -->
    <div class="d-flex align-items-center gap-2 mb-3 mt-3">
        <a href="/Instances" class="btn btn-sm btn-outline-secondary">&larr; 返回实例列表</a>
        <h5 class="mb-0" id="pageTitle">实例管理</h5>
        <span id="pageStatus" class="badge bg-secondary">加载中...</span>
    </div>

    <!-- 标签页切换 -->
    <ul class="nav nav-tabs mb-3" id="manageTabs">
        <li class="nav-item">
            <button class="nav-link active" data-tab="detail" onclick="switchTab('detail')">基本配置</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="playerMgr" onclick="switchTab('playerMgr')">玩家管理</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="serverCfg" onclick="switchTab('serverCfg')">全服配置</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="fileMgr" onclick="switchTab('fileMgr')">文件管理</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="plugins" onclick="switchTab('plugins')">插件管理</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="mods" onclick="switchTab('mods')">模组管理</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="backup" onclick="switchTab('backup')">备份管理</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="logs" onclick="switchTab('logs')">日志管理</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="players" onclick="switchTab('players')">玩家监控</button>
        </li>
    </ul>

    <!-- 基本配置 -->
    <div class="tab-pane-content" id="tab-detail">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label small">显示名称</label>
                        <input type="text" class="form-control form-control-sm" id="mg_inst_name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">分析模式</label>
                        <select class="form-select form-select-sm" id="mg_inst_mode">
                            @foreach (var m in new[] { ("RM", "RM - 管理(推荐)"), ("RUN", "RUN - 子进程"), ("RR", "RR - 子进程+Rcon"), ("RCON", "RCON - 纯远程") })
                            {
                                <option value="@m.Item1">@m.Item2</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">服务端文件 <span class="text-muted">(工作目录第一层 .jar)</span></label>
                        <div class="d-flex gap-1 align-items-center">
                        <div class="jar-select">
                            <input type="text" class="form-control form-control-sm" id="mg_inst_serverJar" placeholder="如 server.jar"
                                   onchange="syncRunFlags()" onfocus="showJarDropdown()" oninput="filterJarDropdown()"
                                   autocomplete="off" />
                            <div class="jar-dropdown" id="mg_jarDropdown" hidden></div>
                        </div>
                        <button class="btn btn-sm btn-outline-info flex-shrink-0" onclick="scanServerJars(this)" title="扫描工作目录第一层的 jar 文件">扫描</button>
                    </div>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">工作目录</label>
                    <input type="text" class="form-control form-control-sm" id="mg_inst_workPath" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Java 路径 <span class="text-muted">(可手动输入)</span></label>
                    <div class="d-flex gap-1 align-items-center">
                        <input type="text" class="form-control form-control-sm" id="mg_inst_javaPath" placeholder="如 java 或 C:\...\java.exe" />
                        <select class="form-select form-select-sm flex-shrink-0" id="mg_javaSelect" style="width:150px;" onchange="onJavaSelected()">
                            <option value="">选择 Java</option>
                        </select>
                        <button class="btn btn-sm btn-outline-info flex-shrink-0" onclick="scanJavas(this)">扫描</button>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label small mb-0">启动参数</label>
                        <select class="form-select form-select-sm" style="width:auto;" id="mg_flagsPreset" onchange="applyFlagsPreset()">
                            <option value="">预设: 保持当前</option>
                            <option value="aikar">Aikar's Flags (G1GC 优化)</option>
                            <option value="velocity">Velocity 代理端推荐</option>
                            <option value="waterfall">Waterfall 代理端推荐</option>
                            <option value="none">无 Flags (仅内存+jar)</option>
                        </select>
                    </div>
                    <textarea class="form-control form-control-sm mt-1" id="mg_inst_runFlags" rows="2"></textarea>
                </div>
                <div class="mb-3 ps-2 pe-2 border rounded pt-2 pb-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-info fw-bold">内存调节</span>
                        <small class="text-muted" id="mg_memHostInfo">主机总内存: 获取中...</small>
                    </div>
                    <div class="row g-2 align-items-center">
                        <div class="col-auto" style="width:52px;"><small class="text-muted">最小</small></div>
                        <div class="col">
                            <input type="range" class="form-range" id="mg_memMin" min="128" step="128" value="1024" oninput="onMemChange()" />
                        </div>
                        <div class="col-auto" style="width:150px;">
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control form-control-sm" id="mg_memMinNum" min="128" step="128" value="1024" onchange="onMemNumChange('min')" />
                                <span class="input-group-text small">MB</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center mt-1">
                        <div class="col-auto" style="width:52px;"><small class="text-muted">最大</small></div>
                        <div class="col">
                            <input type="range" class="form-range" id="mg_memMax" min="128" step="128" value="1024" oninput="onMemChange()" />
                        </div>
                        <div class="col-auto" style="width:150px;">
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control form-control-sm" id="mg_memMaxNum" min="128" step="128" value="1024" onchange="onMemNumChange('max')" />
                                <span class="input-group-text small">MB</span>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-1">调节后自动同步到启动参数的 -Xms/-Xmx (Aikar's 建议两者相同)</small>
                </div>
                <div class="mb-3">
                    <div class="form-check form-check-inline">
                        <input type="checkbox" class="form-check-input" id="mg_inst_hidden" onchange="toggleHidden()" />
                        <label class="form-check-label small" for="mg_inst_hidden">隐藏控制台消息(同步到 config.yml)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="checkbox" class="form-check-input" id="mg_inst_autoRestart" />
                        <label class="form-check-label small" for="mg_inst_autoRestart">崩溃自动重启</label>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-primary" onclick="saveInstanceConfig()">保存配置</button>
                    <button class="btn btn-sm btn-outline-success" onclick="singleAction('start')">启动</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="singleAction('stop')">停止</button>
                    <button class="btn btn-sm btn-outline-warning" onclick="singleAction('restart')">重启</button>
                    <button class="btn btn-sm btn-outline-danger ms-auto" onclick="deleteSingle()">删除此实例</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 玩家管理 -->
    <div class="tab-pane-content" id="tab-playerMgr" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header"><span>玩家管理</span></div>
            <div class="card-body">
                <!-- 快速操作 -->
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small">玩家名 / IP</label>
                        <input type="text" class="form-control form-control-sm" id="pm_target" placeholder="输入玩家名或IP" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">原因(可选)</label>
                        <input type="text" class="form-control form-control-sm" id="pm_reason" placeholder="封禁/踢出原因" />
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap mb-3">
                    <button class="btn btn-sm btn-danger" onclick="playerAction('ban')">封禁玩家</button>
                    <button class="btn btn-sm btn-success" onclick="playerAction('pardon')">解封玩家</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="playerAction('ban_ip')">封禁IP</button>
                    <button class="btn btn-sm btn-outline-success" onclick="playerAction('pardon_ip')">解封IP</button>
                    <button class="btn btn-sm btn-warning" onclick="playerAction('kick')">踢出玩家</button>
                    <button class="btn btn-sm btn-outline-info" onclick="playerAction('op')">设为OP</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="playerAction('deop')">移除OP</button>
                </div>
                <hr class="border-secondary" />
                <!-- 自定义命令 -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="small">自定义命令</strong>
                    <div class="d-flex gap-1">
                        <input type="text" class="form-control form-control-sm" id="pm_cc_name" placeholder="名称" style="width:100px;" />
                        <input type="text" class="form-control form-control-sm" id="pm_cc_command" placeholder="命令(如 say Hello)" style="width:220px;" />
                        <button class="btn btn-sm btn-outline-primary" onclick="addCustomCommand()">添加</button>
                        <button class="btn btn-sm btn-outline-success" onclick="saveCustomCommands()">保存</button>
                    </div>
                </div>
                <div id="customCommandList" class="border rounded" style="max-height:250px;overflow-y:auto;">
                    <div class="text-muted small p-2">暂无自定义命令</div>
                </div>
                <small class="text-muted d-block mt-2">自定义命令保存在 panel_data.json 中,点击命令可快速执行</small>
            </div>
        </div>
    </div>

    <!-- 文件管理 -->
    <div class="tab-pane-content" id="tab-fileMgr" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>文件管理</span>
                <div class="d-flex gap-1 align-items-center">
                    <input type="file" id="fmUploadInput" multiple style="display:none;" onchange="FileMgr.upload(this.files)" />
                    <button class="btn btn-sm btn-outline-success" onclick="document.getElementById('fmUploadInput').click()">+ 上传</button>
                    <button class="btn btn-sm btn-outline-info" onclick="FileMgr.refresh()">刷新</button>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="fm-breadcrumb" id="fmBreadcrumb"></div>
                <div class="fm-layout">
                    <div class="fm-tree-pane">
                        <input type="text" class="form-control form-control-sm fm-search" id="fmSearch"
                               placeholder="搜索文件..." oninput="FileMgr.renderTree()" />
                        <div class="fm-tree" id="fmTree">
                            <div class="text-muted small p-2">正在加载目录树...</div>
                        </div>
                    </div>
                    <div class="fm-list-pane" id="fmListPane"
                         ondragover="FileMgr.onPaneDragOver(event)" ondragleave="FileMgr.onDragLeave(event)"
                         ondrop="FileMgr.onPaneDrop(event)">
                        <div class="fm-list" id="fmList">
                            <div class="text-muted small p-3">正在加载文件列表...</div>
                        </div>
                    </div>
                </div>
                <small class="text-muted d-block mt-2">提示: 长按文件拖拽到文件夹(或左侧目录树)即可移动; 也可从系统直接拖文件进来上传。仅可访问实例工作目录内的文件。</small>
            </div>
        </div>
    </div>

    <!-- 插件管理 -->
    <div class="tab-pane-content" id="tab-plugins" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>插件管理</span>
                <div class="d-flex gap-1 align-items-center">
                    <input type="file" id="pluginUploadInput" accept=".jar" style="display:none;" onchange="uploadJar('plugin', this)" />
                    <button class="btn btn-sm btn-outline-success" onclick="document.getElementById('pluginUploadInput').click()">+ 上传插件</button>
                    <button class="btn btn-sm btn-outline-info" onclick="loadJarFiles('plugin')">刷新</button>
                </div>
            </div>
            <div class="card-body">
                <div id="pluginList" class="border rounded" style="max-height:500px;overflow-y:auto;">
                    <div class="text-muted small p-3">点击「刷新」加载插件列表...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 模组管理 -->
    <div class="tab-pane-content" id="tab-mods" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>模组管理</span>
                <div class="d-flex gap-1 align-items-center">
                    <input type="file" id="modUploadInput" accept=".jar" style="display:none;" onchange="uploadJar('mod', this)" />
                    <button class="btn btn-sm btn-outline-success" onclick="document.getElementById('modUploadInput').click()">+ 上传模组</button>
                    <button class="btn btn-sm btn-outline-info" onclick="loadJarFiles('mod')">刷新</button>
                </div>
            </div>
            <div class="card-body">
                <div id="modList" class="border rounded" style="max-height:500px;overflow-y:auto;">
                    <div class="text-muted small p-3">点击「刷新」加载模组列表...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 备份管理 -->
    <div class="tab-pane-content" id="tab-backup" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>备份管理</span>
                <button class="btn btn-sm btn-outline-success" onclick="createBackup()">+ 创建备份</button>
            </div>
            <div class="card-body">
                <div id="backupList" class="border rounded" style="max-height:400px;overflow-y:auto;">
                    <div class="text-muted small p-3">加载中...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 日志管理 -->
    <div class="tab-pane-content" id="tab-logs" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>日志管理</span>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info" onclick="loadInstanceLog()">查看日志</button>
                    <button class="btn btn-sm btn-outline-warning" onclick="analyzeInstanceErrors()">分析错误</button>
                    <button class="btn btn-sm btn-outline-success" onclick="shareInstanceLog()">分享日志</button>
                </div>
            </div>
            <div class="card-body">
                <div id="instanceLogArea" class="border rounded mb-2" style="max-height:400px;overflow-y:auto;background:#0d0d1a;padding:8px;font-family:Consolas,monospace;font-size:12px;line-height:1.5;display:none;">
                    <div class="text-muted p-2">点击「查看日志」加载...</div>
                </div>
                <div id="instanceErrorArea" style="display:none;"></div>
                <div id="instanceAiArea" style="display:none;"></div>
            </div>
        </div>
    </div>

    <!-- 玩家监控 -->
    <div class="tab-pane-content" id="tab-players" style="display:none;">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>玩家活动时间表</span>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <select class="form-select form-select-sm" id="playerEventFilter" onchange="renderPlayerEvents()" style="width:auto;">
                        <option value="">全部事件</option>
                        <option value="join">加入</option>
                        <option value="connect">连接</option>
                        <option value="leave">离开</option>
                        <option value="lost">掉线</option>
                        <option value="command">命令</option>
                        <option value="chat">聊天</option>
                        <option value="setmode">模式切换</option>
                        <option value="op">OP 授予</option>
                        <option value="deop">OP 移除</option>
                        <option value="ban">封禁</option>
                        <option value="unban">解封</option>
                        <option value="ip_ban">IP 封禁</option>
                        <option value="ip_unban">IP 解封</option>
                    </select>
                    <input type="text" class="form-control form-control-sm" id="playerEventSearch" placeholder="搜索玩家名/内容" oninput="renderPlayerEvents()" style="width:180px;" />
                    <button class="btn btn-sm btn-outline-info" onclick="loadPlayerEvents()">刷新</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="clearPlayerEvents()">清空</button>
                </div>
            </div>
            <div class="card-body">
                <div id="playerStatsRow" class="row g-2 mb-3">
                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-sky fs-5 fw-bold" id="statTotal">0</div>
                            <small class="text-muted">总事件</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-success fs-5 fw-bold" id="statJoin">0</div>
                            <small class="text-muted">加入/连接</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-warning fs-5 fw-bold" id="statCmd">0</div>
                            <small class="text-muted">命令</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-info fs-5 fw-bold" id="statChat">0</div>
                            <small class="text-muted">聊天</small>
                        </div>
                    </div>
                </div>
                <div id="playerTimeline" class="player-timeline">
                    <div class="text-muted text-center py-4">点击「刷新」加载玩家事件...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 全服配置 (RM 管理协议 serversettings) -->
    <div class="tab-pane-content" id="tab-serverCfg" style="display:none;">
        <div class="alert alert-secondary small mb-3">
            通过服务端管理协议读写全服配置(serversettings)、游戏规则、名单与服务器控制。仅支持 <strong style="color:#ff6a3d;">MC 1.21.9+</strong> 且在实例中开启了管理协议、当前实例为运行中的 RM 模式实例；非 RM 实例的部分增删操作会自动降级为命令通道，读取类操作不可用。
        </div>

        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>全服配置</span>
                <div class="d-flex gap-1 align-items-center">
                    <button class="btn btn-sm btn-outline-info" onclick="loadServerSettings()">刷新</button>
                    <button class="btn btn-sm btn-outline-success" onclick="saveServerSettings()">保存</button>
                </div>
            </div>
            <div class="card-body">
                <div id="serverSettingsBody">
                    <div class="text-muted text-center py-4">点击「刷新」加载全服配置...</div>
                </div>
            </div>
        </div>

        <!-- 服务器控制 -->
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header"><span>服务器控制</span></div>
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap mb-3">
                    <button class="btn btn-sm btn-outline-info" onclick="rmServerAction('status')">查询状态</button>
                    <button class="btn btn-sm btn-outline-success" onclick="rmServerAction('save')">保存世界</button>
                    <button class="btn btn-sm btn-danger" onclick="rmServerAction('stop')">停止服务器</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="rmDiscover()">能力发现 (discover)</button>
                </div>
                <div class="row g-2 align-items-center">
                    <div class="col-md-7">
                        <input type="text" class="form-control form-control-sm" id="rm_msg_text" placeholder="系统消息内容" />
                    </div>
                    <div class="col-md-3">
                        <label class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 mb-0">
                            <input type="checkbox" id="rm_msg_overlay" /> 标题叠加显示
                        </label>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-outline-primary w-100" onclick="rmServerAction('system_message')">发送系统消息</button>
                    </div>
                </div>
                <pre id="rm_raw" class="small mt-3 mb-0 p-2 border rounded" style="display:none;max-height:260px;overflow:auto;white-space:pre-wrap;"></pre>
            </div>
        </div>

        <!-- 游戏规则 -->
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>游戏规则 (gamerules)</span>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info" onclick="loadGamerules()">刷新</button>
                    <button class="btn btn-sm btn-outline-success" onclick="saveGamerules()">保存全部</button>
                </div>
            </div>
            <div class="card-body">
                <div id="gamerulesBody">
                    <div class="text-muted text-center py-4">点击「刷新」加载游戏规则...</div>
                </div>
            </div>
        </div>

        <!-- 名单管理 -->
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>名单管理</span>
                <div class="d-flex gap-1 align-items-center">
                    <select class="form-select form-select-sm" id="rm_list_type" style="width:180px;" onchange="loadRmList()">
                        <option value="allowlist">白名单 (allowlist)</option>
                        <option value="operators">OP 名单 (operators)</option>
                        <option value="bans">封禁名单 (bans)</option>
                        <option value="ip_bans">IP 封禁 (ip_bans)</option>
                    </select>
                    <button class="btn btn-sm btn-outline-info" onclick="loadRmList()">刷新</button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm" id="rm_list_target" placeholder="名称 / IP" />
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm" id="rm_list_reason" placeholder="原因(封禁时可选)" />
                    </div>
                    <div class="col-md-4 d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary" onclick="rmListAction('add')">添加</button>
                        <button class="btn btn-sm btn-danger" onclick="rmListAction('clear')">清空(仅白名单)</button>
                    </div>
                </div>
                <div id="rmListBody" class="border rounded" style="max-height:360px;overflow-y:auto;">
                    <div class="text-muted small p-2">选择名单类型并点击「刷新」加载...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const INSTANCE_ID = '@Model.Id';
    let currentInstance = null;
    let allPlayerEvents = [];

    function escapeHtml(s) {
        return (s ?? '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function showStatus(msg, type) {
        if (window.RtPanel && RtPanel.showToast) { RtPanel.showToast(msg, type); return; }
        console.log(`[${type}] ${msg}`);
    }
    function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes/1024).toFixed(1) + ' KB';
        if (bytes < 1073741824) return (bytes/1048576).toFixed(1) + ' MB';
        return (bytes/1073741824).toFixed(2) + ' GB';
    }
    function switchTab(tab) {
        document.querySelectorAll('#manageTabs .nav-link').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-pane-content').forEach(p => p.style.display = 'none');
        document.querySelector(`[data-tab="${tab}"]`).classList.add('active');
        document.getElementById(`tab-${tab}`).style.display = '';
        if (tab === 'players' && allPlayerEvents.length === 0) loadPlayerEvents();
        if (tab === 'playerMgr') loadCustomCommands();
        if (tab === 'serverCfg') {
            loadServerSettings();
            if (gameruleCache.length === 0) loadGamerules();
            if (rmListCache.length === 0) loadRmList();
        }
        if (tab === 'plugins') loadJarFiles('plugin');
        if (tab === 'mods') loadJarFiles('mod');
        if (tab === 'fileMgr') FileMgr.ensureInit();
    }

    // === 加载实例详情 ===
    async function loadDetail() {
        if (!INSTANCE_ID) { showStatus('缺少实例ID', 'danger'); return; }
        const resp = await fetch(`/api/instances/detail?id=${encodeURIComponent(INSTANCE_ID)}`).then(r => r.json());
        if (!resp.success) { showStatus(resp.message, 'danger'); return; }
        const inst = resp.instance;
        currentInstance = inst;
        const backups = resp.backups || [];

        document.getElementById('pageTitle').textContent = `管理: ${inst.name} (${inst.id})`;
        const statusBadge = document.getElementById('pageStatus');
        statusBadge.className = inst.isRunning ? 'badge bg-success' : 'badge bg-secondary';
        statusBadge.textContent = inst.isRunning ? '运行中' : '已停止';

        document.getElementById('mg_inst_name').value = inst.name;
        // 与 RtCli Analyzer 模式规范一致: 旧名自动映射到 RM/RUN/RR/RCON
        document.getElementById('mg_inst_mode').value = ({
            MANAGEMENT: 'RM', RUN: 'RUN', RCON: 'RCON', ONLYRCON: 'RCON',
            RM: 'RM', RR: 'RR'
        })[(inst.analyzerMode || 'RM').toUpperCase()] || 'RM';
        document.getElementById('mg_inst_workPath').value = inst.workPath;
        document.getElementById('mg_inst_javaPath').value = inst.javaPath;
        document.getElementById('mg_inst_runFlags').value = inst.runFlags;
        document.getElementById('mg_inst_hidden').checked = inst.hidden;
        document.getElementById('mg_inst_autoRestart').checked = inst.autoRestart;

        initRunFlagsWidgets();

        renderBackups(backups);
    }

    // ===== 启动参数 / 内存 / 服务端文件 联动 =====

    const FLAGS_PRESETS = {
        aikar: "-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true",
        velocity: "-XX:+UseG1GC -XX:G1HeapRegionSize=4M -XX:MaxInlineLevel=15",
        waterfall: "-XX:+UseG1GC -XX:MaxInlineLevel=15",
        none: ""
    };

    // 解析启动参数: -Xms/-Xmx → xms/xmx(MB), -jar 后第一个 token → jar, 其余为 extra(尾部参数 tail)
    function parseRunFlags() {
        const raw = document.getElementById('mg_inst_runFlags').value.trim();
        const tokens = raw.split(/\s+/).filter(t => t.length > 0);
        let xms = 0, xmx = 0, jar = '';
        const extra = [], tail = [];
        let jarIdx = -1;
        for (let i = 0; i < tokens.length; i++) {
            if (tokens[i] === '-jar') { jarIdx = i; break; }
        }
        if (jarIdx >= 0 && jarIdx + 1 < tokens.length) jar = tokens[jarIdx + 1];
        const jarEnd = jarIdx >= 0 ? jarIdx + 2 : tokens.length;
        for (let i = 0; i < jarEnd; i++) {
            if (i === jarIdx || (jarIdx >= 0 && i === jarIdx + 1)) continue;
            const t = tokens[i];
            let m;
            if ((m = t.match(/^-Xms(\d+)([KkMmGg]?)$/))) { xms = toMB(m[1], m[2]); continue; }
            if ((m = t.match(/^-Xmx(\d+)([KkMmGg]?)$/))) { xmx = toMB(m[1], m[2]); continue; }
            extra.push(t);
        }
        for (let i = jarEnd; i < tokens.length; i++) tail.push(tokens[i]);
        return { xms, xmx, extra, jar, tail };
    }

    function toMB(v, unit) {
        v = parseInt(v, 10);
        if (unit === 'G' || unit === 'g') return v * 1024;
        if (unit === 'K' || unit === 'k') return Math.round(v / 1024);
        return v;
    }

    function mbToToken(mb) { return (mb >= 1024 && mb % 1024 === 0) ? `${mb / 1024}G` : `${mb}M`; }

    // 重组启动参数(保持 -Xms -Xmx extra -jar jar tail 顺序)
    function rebuildRunFlags(p) {
        const parts = [];
        if (p.xms > 0) parts.push(`-Xms${mbToToken(p.xms)}`);
        if (p.xmx > 0) parts.push(`-Xmx${mbToToken(p.xmx)}`);
        parts.push(...p.extra);
        if (p.jar) parts.push('-jar', p.jar);
        parts.push(...p.tail);
        return parts.join(' ');
    }

    // 从启动参数初始化服务端文件框与内存滑块
    function initRunFlagsWidgets() {
        const p = parseRunFlags();
        document.getElementById('mg_inst_serverJar').value = p.jar;
        document.getElementById('mg_flagsPreset').value = '';
        const hostMax = window._mgHostMemMB || 8192;
        setMemWidgets('min', p.xms > 0 ? p.xms : 1024, hostMax);
        setMemWidgets('max', p.xmx > 0 ? p.xmx : (p.xms > 0 ? p.xms : 1024), hostMax);
    }

    function setMemWidgets(which, mb, hostMax) {
        const clamped = Math.max(128, Math.min(mb, hostMax));
        const slider = document.getElementById(which === 'min' ? 'mg_memMin' : 'mg_memMax');
        const num = document.getElementById(which === 'min' ? 'mg_memMinNum' : 'mg_memMaxNum');
        slider.max = hostMax; num.max = hostMax;
        slider.value = clamped; num.value = clamped;
    }

    // 滑块/数字框变更 → 联动并写回启动参数
    function onMemChange() {
        const minS = document.getElementById('mg_memMin'), maxS = document.getElementById('mg_memMax');
        let mn = parseInt(minS.value, 10) || 128, mx = parseInt(maxS.value, 10) || 128;
        if (mn > mx) { // min 超过 max: 联动另一端
            if (document.activeElement === minS) { maxS.value = mn; document.getElementById('mg_memMaxNum').value = mn; mx = mn; }
            else { minS.value = mx; document.getElementById('mg_memMinNum').value = mx; mn = mx; }
        }
        document.getElementById('mg_memMinNum').value = mn;
        document.getElementById('mg_memMaxNum').value = mx;
        writeMemToFlags(mn, mx);
    }

    function onMemNumChange(which) {
        const slider = document.getElementById(which === 'min' ? 'mg_memMin' : 'mg_memMax');
        const num = document.getElementById(which === 'min' ? 'mg_memMinNum' : 'mg_memMaxNum');
        let v = parseInt(num.value, 10) || 128;
        const hostMax = window._mgHostMemMB || 8192;
        v = Math.max(128, Math.min(v, hostMax));
        num.value = v; slider.value = v;
        onMemChange();
    }

    function writeMemToFlags(mn, mx) {
        const p = parseRunFlags();
        p.xms = mn; p.xmx = mx;
        document.getElementById('mg_inst_runFlags').value = rebuildRunFlags(p);
    }

    // 启动参数预设: 替换 extra 部分, 保留内存/-jar/尾部参数
    function applyFlagsPreset() {
        const key = document.getElementById('mg_flagsPreset').value;
        if (!key) return;
        const p = parseRunFlags();
        p.extra = FLAGS_PRESETS[key].length ? FLAGS_PRESETS[key].split(/\s+/) : [];
        document.getElementById('mg_inst_runFlags').value = rebuildRunFlags(p);
    }

    // 服务端文件框变更 → 同步 -jar 部分
    function syncRunFlags() {
        const p = parseRunFlags();
        p.jar = document.getElementById('mg_inst_serverJar').value.trim();
        document.getElementById('mg_inst_runFlags').value = rebuildRunFlags(p);
    }

    // === 服务端文件(jar)自定义下拉框(替代浏览器原生 datalist) ===
    let scannedJars = [];

    function renderJarDropdown(filter) {
        const dd = document.getElementById('mg_jarDropdown');
        if (!dd) return;
        const kw = (filter || '').toLowerCase();
        const items = scannedJars.filter(j => j.toLowerCase().includes(kw));
        if (items.length === 0) {
            dd.innerHTML = `<div class="jar-dropdown-empty">${scannedJars.length ? '无匹配的 jar' : '请先点击"扫描"'}</div>`;
            return;
        }
        dd.innerHTML = items.map(j => `<div class="jar-dropdown-item" data-jar="${escapeHtml(j)}">${escapeHtml(j)}</div>`).join('');
        dd.querySelectorAll('.jar-dropdown-item').forEach(el => {
            // 用 mousedown 在输入框 blur 之前完成选择
            el.addEventListener('mousedown', (ev) => { ev.preventDefault(); pickJar(el.dataset.jar); });
        });
    }

    function showJarDropdown() {
        const dd = document.getElementById('mg_jarDropdown');
        if (!dd) return;
        renderJarDropdown(document.getElementById('mg_inst_serverJar').value.trim());
        dd.hidden = false;
    }

    function filterJarDropdown() {
        const dd = document.getElementById('mg_jarDropdown');
        if (!dd || dd.hidden) return;
        renderJarDropdown(document.getElementById('mg_inst_serverJar').value.trim());
    }

    function pickJar(name) {
        document.getElementById('mg_inst_serverJar').value = name;
        document.getElementById('mg_jarDropdown').hidden = true;
        syncRunFlags();
    }

    // 点击下拉框/输入框之外时收起
    document.addEventListener('click', (e) => {
        const dd = document.getElementById('mg_jarDropdown');
        if (!dd || dd.hidden) return;
        const box = e.target.closest ? e.target.closest('.jar-select') : null;
        if (!box) dd.hidden = true;
    });

    // 扫描工作目录第一层 jar 文件(不深入子目录, 避免扫描到插件/模组)
    async function scanServerJars(btn) {
        btn.disabled = true; btn.textContent = '扫描中';
        try {
            const resp = await fetch(`/api/instances/file/list?id=${encodeURIComponent(INSTANCE_ID)}&path=`).then(r => r.json());
            if (!resp.success) { showStatus(resp.message || '扫描失败', 'danger'); return; }
            scannedJars = (resp.entries || []).filter(e => !e.isDir && e.name.toLowerCase().endsWith('.jar')).map(e => e.name);
            if (scannedJars.length === 0) {
                document.getElementById('mg_jarDropdown').hidden = true;
                showStatus('工作目录第一层未找到 .jar 文件', 'warning');
                return;
            }
            const cur = document.getElementById('mg_inst_serverJar').value.trim();
            if (!cur && scannedJars.length === 1) { // 只有一个 jar 时自动填入
                document.getElementById('mg_inst_serverJar').value = scannedJars[0];
                syncRunFlags();
            }
            renderJarDropdown(document.getElementById('mg_inst_serverJar').value.trim());
            document.getElementById('mg_jarDropdown').hidden = false;
            showStatus(`扫描到 ${scannedJars.length} 个 jar: ${scannedJars.slice(0, 5).join(', ')}${scannedJars.length > 5 ? ' ...' : ''}`, 'success');
        } catch { showStatus('扫描请求失败', 'danger'); }
        finally { btn.disabled = false; btn.textContent = '扫描'; }
    }

    // 扫描主机 Java 安装
    async function scanJavas(btn) {
        btn.disabled = true; btn.textContent = '扫描中';
        try {
            const resp = await fetch('/api/instances/javas').then(r => r.json());
            if (!resp.success) { showStatus(resp.message || '扫描失败', 'danger'); return; }
            const sel = document.getElementById('mg_javaSelect');
            const cur = document.getElementById('mg_inst_javaPath').value.trim();
            sel.innerHTML = '<option value="">选择 Java</option>' + (resp.javas || []).map(j => {
                const short = j.path.length > 46 ? '...' + j.path.slice(-44) : j.path;
                const selAttr = j.path === cur ? ' selected' : '';
                return `<option value="${escapeHtml(j.path)}"${selAttr}>${escapeHtml(j.version)} · ${escapeHtml(j.source)} · ${escapeHtml(short)}</option>`;
            }).join('');
            showStatus(`扫描到 ${resp.javas.length} 个 Java (下拉选择或继续手动输入)`, 'success');
        } catch { showStatus('扫描请求失败', 'danger'); }
        finally { btn.disabled = false; btn.textContent = '扫描'; }
    }

    function onJavaSelected() {
        const sel = document.getElementById('mg_javaSelect');
        if (sel.value) document.getElementById('mg_inst_javaPath').value = sel.value;
    }

    // 获取主机总内存作为内存调节上限
    async function loadHostMem() {
        try {
            const resp = await fetch('/api/system/stats').then(r => r.json());
            if (resp.success && resp.memoryTotalMb > 0) {
                window._mgHostMemMB = resp.memoryTotalMb;
                document.getElementById('mg_memHostInfo').textContent = `主机总内存: ${(resp.memoryTotalMb / 1024).toFixed(1)} GB`;
                // 若滑块已初始化, 更新上限
                const mnS = document.getElementById('mg_memMin'), mxS = document.getElementById('mg_memMax');
                if (parseInt(mnS.max, 10) <= 8192 && mnS.value) { // 仅在默认上限时重置
                    setMemWidgets('min', parseInt(mnS.value, 10), resp.memoryTotalMb);
                    setMemWidgets('max', parseInt(mxS.value, 10), resp.memoryTotalMb);
                }
            } else {
                document.getElementById('mg_memHostInfo').textContent = '主机总内存: 获取失败';
            }
        } catch {
            document.getElementById('mg_memHostInfo').textContent = '主机总内存: 获取失败';
        }
    }

    function renderBackups(backups) {
        const container = document.getElementById('backupList');
        if (!backups || backups.length === 0) {
            container.innerHTML = '<div class="text-muted small p-3">暂无备份</div>';
            return;
        }
        container.innerHTML = backups.map(b => `<div class="d-flex justify-content-between align-items-center border-bottom p-2">
            <div>
                <div class="small">${escapeHtml(b.fileName)}</div>
                <small class="text-muted">${escapeHtml(b.createdAt)} · ${formatBytes(b.sizeBytes)}</small>
            </div>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-warning" onclick="restoreBackup('${escapeHtml(b.fileName)}')">恢复</button>
                <button class="btn btn-outline-danger" onclick="deleteBackup('${escapeHtml(b.fileName)}')">删除</button>
            </div>
        </div>`).join('');
    }

    async function toggleHidden() {
        const hidden = document.getElementById('mg_inst_hidden').checked;
        const resp = await fetch('/api/instances/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id: INSTANCE_ID, hidden })
        }).then(r => r.json());
        showStatus(resp.message || (resp.success ? '已更新隐藏设置' : '更新失败'), resp.success ? 'success' : 'danger');
    }

    async function saveInstanceConfig() {
        const payload = {
            id: INSTANCE_ID,
            name: document.getElementById('mg_inst_name').value,
            workPath: document.getElementById('mg_inst_workPath').value,
            javaPath: document.getElementById('mg_inst_javaPath').value,
            runFlags: document.getElementById('mg_inst_runFlags').value,
            analyzerMode: document.getElementById('mg_inst_mode').value,
            hidden: document.getElementById('mg_inst_hidden').checked,
            autoRestart: document.getElementById('mg_inst_autoRestart').checked
        };
        const resp = await fetch('/api/instances/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify(payload)
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadDetail();
    }

    async function singleAction(action) {
        const resp = await fetch('/api/instances/action', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ action, ids: [INSTANCE_ID] })
        }).then(r => r.json());
        showStatus(resp.message || (resp.success ? '操作成功' : '操作失败'), resp.success ? 'success' : 'danger');
        if (resp.success) loadDetail();
    }

    async function deleteSingle() {
        if (!confirm(`确定删除实例「${INSTANCE_ID}」?config.yml 中的配置也会被移除。`)) return;
        const resp = await fetch('/api/instances/delete', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id: INSTANCE_ID, deleteFiles: false })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) window.location.href = '/Instances';
    }

    // === 备份 ===
    async function createBackup() {
        showStatus('正在创建备份...', 'info');
        const resp = await fetch('/api/instances/backup/create', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id: INSTANCE_ID })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadDetail();
    }
    async function restoreBackup(fileName) {
        if (!confirm(`确定从「${fileName}」恢复?当前文件会被自动备份。`)) return;
        showStatus('正在恢复...', 'info');
        const resp = await fetch('/api/instances/backup/restore', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id: INSTANCE_ID, fileName })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadDetail();
    }
    async function deleteBackup(fileName) {
        if (!await RtPanel.showConfirm('删除备份', `确定删除备份「${fileName}」?此操作不可恢复。`)) return;
        const resp = await fetch('/api/instances/backup/delete', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id: INSTANCE_ID, fileName })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadDetail();
    }

    // === 日志 ===
    async function loadInstanceLog() {
        const area = document.getElementById('instanceLogArea');
        area.style.display = '';
        area.innerHTML = '<div class="text-muted p-2">正在加载日志...</div>';
        const resp = await fetch(`/api/instances/log?id=${encodeURIComponent(INSTANCE_ID)}&maxLines=500`).then(r => r.json());
        if (!resp.success) { area.innerHTML = `<div class="text-danger p-2">${escapeHtml(resp.message || '加载失败')}</div>`; return; }
        const lines = (resp.content || '').split('\n');
        // 交给共享渲染器: 级别着色 + 多行错误合并。
        // 原先逐行正则着色有两处问题:
        //   1) 堆栈续行(at ... / Caused by: / ... N more)不含级别关键字, 被渲染成普通行, 错误被拆散;
        //   2) /<\/?INFO/i 匹配的是字面量 "<INFO", 而实际是 "[Server thread/INFO]", 所以 INFO 从未着色。
        area.innerHTML = window.RtLog
            ? RtLog.render(lines)
            : lines.map(line => `<div class="text-light">${escapeHtml(line) || '&nbsp;'}</div>`).join('');
        area.scrollTop = area.scrollHeight;
    }

    async function analyzeInstanceErrors() {
        const errArea = document.getElementById('instanceErrorArea');
        errArea.style.display = '';
        errArea.innerHTML = '<div class="text-muted p-2">正在分析错误...</div>';
        const resp = await fetch('/api/instances/errors/analyze', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id: INSTANCE_ID })
        }).then(r => r.json());
        if (!resp.success) { errArea.innerHTML = `<div class="text-danger p-2">${escapeHtml(resp.message || '分析失败')}</div>`; return; }
        const errors = resp.errors || [];
        if (errors.length === 0) { errArea.innerHTML = '<div class="text-success p-2">未检测到错误</div>'; return; }
        errArea.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-muted">错误列表 · 检测到 ${errors.length} 条错误(按错误块聚合, 含堆栈)</small>
                <div class="d-flex gap-1">
                    <input type="text" class="form-control form-control-sm" id="aiRangeInput" placeholder="如 1 或 1-3(空=全部)" style="width:140px;" />
                    <button class="btn btn-sm btn-outline-info" onclick="baseAnalyzeErrors()">基础分析</button>
                    <button class="btn btn-sm btn-primary" onclick="aiAnalyzeErrors()">AI分析</button>
                </div>
            </div>
            <div class="border rounded" style="max-height:250px;overflow-y:auto;">
                ${errors.map(e => `<div class="border-bottom p-2">
                    <span class="badge bg-danger">#${e.index}</span>
                    <div class="small mt-1">${window.RtLog ? RtLog.render((e.content || '').split('\n')) : escapeHtml(e.content)}</div>
                </div>`).join('')}
