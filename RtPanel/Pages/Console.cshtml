@page
@model RtPanel.Pages.ConsoleModel
@{
    ViewData["Title"] = "控制台";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>命令执行</span>
                <div>
                    <button class="btn btn-sm btn-outline-info" onclick="clearLogs()">清空</button>
                    <select id="logSourceFilter" class="form-select form-select-sm log-source-select" onchange="applyLogFilter()" title="按来源过滤日志(选 AiAuto/AiTools 可只看AI与工具调用)">
                        <option value="">全部来源</option>
                        <option value="AiAuto">AiAuto(AI任务)</option>
                        <option value="AiAnalyze">AiAnalyze(AI分析)</option>
                        <option value="AiThink">AiThink(AI思考)</option>
                        <option value="AiTools">AiTools(工具调用)</option>
                        <option value="RtEM">RtEM(扩展)</option>
                        <option value="Backend">Backend(面板命令)</option>
                    </select>
                    <label class="btn btn-sm btn-outline-secondary mb-0 d-inline-flex align-items-center gap-1">
                        <input type="checkbox" id="autoScroll" checked onchange="toggleAutoScroll()" /> 自动滚动
                    </label>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="logPanel" style="height: 480px; overflow-y: auto; background:#0d0d1a; padding:12px; font-family: 'Consolas','Courier New',monospace; font-size: 13px; line-height: 1.6;">
                    <div class="text-muted">等待日志...</div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-1 align-items-center">
                    <div class="jar-select">
                        <input type="text" id="cmdInput" class="form-control bg-dark text-light border-secondary"
                               placeholder="输入命令 (如 rt status, .cfg reload, /say hello) 后按回车, TAB 补全"
                               autocomplete="off" />
                        <div class="jar-dropdown" id="cmdDropdown" hidden></div>
                    </div>
                    <button type="button" class="btn btn-outline-info" id="cmdExpandBtn" title="展开命令列表" aria-label="展开命令列表">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                    </button>
                    <button class="btn btn-primary" onclick="executeCommand()" id="execBtn">执行</button>
                </div>
            </div>
        </div>

        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header">快捷命令</div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="quickCmd('rt status')">rt status - 运行状态</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="showTaskInfo('ai','AI任务列表')">AI任务列表</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="showTaskInfo('auto','计划任务列表')">计划任务列表</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="quickCmd('.fx list')">.fx list - 错误分析结果</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="quickCmd('.fx filter plugin')">.fx filter plugin - 插件列表</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="quickCmd('.server list')">.server list - 服务端列表</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="quickCmd('rt extensions')">rt extensions - 扩展列表</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-primary btn-sm w-100 text-start" onclick="quickCmd('rt clients')">rt clients - 已连接面板</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-warning btn-sm w-100 text-start" onclick="quickCmd('.cfg reload')">.cfg reload - 热重载配置</button></div>
                    <div class="col-md-6"><button class="btn btn-outline-info btn-sm w-100 text-start" onclick="quickCmd('rt help')">rt help - 命令帮助</button></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- AI 自动化 -->
        <div class="ai-hero-card mb-3" id="aiHeroCard">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="ai-hero-icon">🖥</span>
                        <div>
                            <div class="ai-hero-title">AI 自动化监管</div>
                            <small class="text-muted">进行无人值守运维前请设置相关参数</small>
                        </div>
                    </div>
                    <span class="ai-status-badge" id="aiStatusBadge"><span class="ai-status-dot"></span><span id="aiStatusText">检测中</span></span>
                </div>
                <p class="small text-muted mb-3 ai-hero-tagline" id="aiHeroTagline" style="font-size:12px;">自动守护服务运行 · 智能分析错误日志 · 自动执行运维任务</p>
                <div class="d-grid mb-2">
                    <button class="btn ai-hero-btn" id="aiHeroToggleBtn" onclick="aiHeroToggle()">▶ 启动 AI 自动化</button>
                </div>
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button class="btn btn-outline-info" onclick="showTaskInfo('ai','AI任务列表')">任务列表</button>
                    <button class="btn btn-outline-warning" onclick="quickCmd('.ai reload')">重载配置</button>
                    <button class="btn btn-outline-danger" onclick="confirmCmd('.ai stop', '确定停止AI自动化监管？')">停止</button>
                </div>
            </div>
        </div>

        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>自动化操作</span>
                <small class="text-muted">一键控制</small>
            </div>
            <div class="card-body">
                <div class="mb-2"><small class="text-info fw-bold">当前实例</small></div>
                <div class="mb-3">
                    <select id="consoleInstanceFilter" class="form-select form-select-sm" onchange="switchConsoleInstance()" title="选择要查看/控制的实例(多实例并发运行)">
                        <option value="">全部实例</option>
                    </select>
                </div>
                <div class="mb-2"><small class="text-info fw-bold">计划任务调度器</small></div>
                <div class="d-grid gap-2 mb-3">
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-outline-success" id="autoStartBtn" onclick="quickCmd('.auto start')">启动</button>
                        <button class="btn btn-outline-danger" onclick="confirmCmd('.auto stop', '确定停止调度器？')">停止</button>
                        <button class="btn btn-outline-info" onclick="showTaskInfo('auto','计划任务列表')">任务列表</button>
                    </div>
                </div>
                <div class="mb-2"><small class="text-info fw-bold">MC服务端</small></div>
                <div class="d-grid gap-2">
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-outline-success" id="serverStartBtn" onclick="confirmCmd('.server start', '确定启动MC服务端？')">启动</button>
                        <button class="btn btn-outline-danger" onclick="confirmCmd('.server stop', '确定停止MC服务端？')">停止</button>
                        <button class="btn btn-outline-warning" onclick="confirmCmd('.server restart', '确定重启MC服务端？')">重启</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-dark text-light border-secondary">
            <div class="card-header">连接信息</div>
            <div class="card-body" id="connInfo">
                <div class="text-muted">加载中...</div>
            </div>
        </div>
    </div>
</div>

<!-- 任务信息弹窗 -->
<div class="modal-overlay" id="taskInfoModal" style="display:none;">
    <div class="modal-box" style="max-width:85vw;width:auto;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-3">
                <h5 id="taskInfoTitle" class="mb-0">任务信息</h5>
                <span id="taskInfoStatus" class="badge bg-secondary"></span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-info" onclick="refreshTaskInfo()" id="taskInfoRefreshBtn">刷新</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('taskInfoModal').style.display='none'">关闭</button>
            </div>
        </div>
        <div id="taskInfoContent" class="border rounded p-3" style="background:var(--bg-input,#0d1b2e);"></div>
    </div>
</div>

@section Scripts {
<script>
    let lastLogSeq = 0;
    let autoScroll = true;
    let commandHistory = [];
    let historyIndex = -1;
    // 当前控制台操作/查看的实例(null = 尚未初始化, 加载实例列表后默认选中当前实例; 空串 = 全部实例)
    let consoleInstanceId = null;

    // ===== 控制台命令自动补全状态 =====
    let availableCommands = [];          // 来自 /api/console/commands 的 [{command, description}]
    let knownCommandSet = new Set();     // 小写命令名集合(词边界匹配用)
    let cmdDropdownOpen = false;
    let cmdCandidates = [];              // 当前候选 [{value, description, isCommand}]
    let cmdHighlightIndex = -1;

    // 叶子命令 -> 参数类型(用于 TAB 参数补全)
    const PARAM_SPECS = {
        '.server change': 'instance',
        '.server get': 'instance',
        '.server start': 'instance',
        '.server stop': 'instance',
        '.server del': 'instance',
        '.server status': 'instance',
        '.server detach': 'instance',
        '.group set': 'instance',
        '.group unset': 'instance',
        'rt extensions load': 'extension',
        'rt extensions unload': 'extension',
        '.ai run': 'aiTask'
    };

    // 参数数据源缓存(懒加载一次，失败静默置空)
    const paramCache = { instance: null, extension: null, aiTask: null };
    const paramLoading = { instance: false, extension: false, aiTask: false };

    function toggleAutoScroll() {
        autoScroll = document.getElementById('autoScroll').checked;
    }

    // ==== 日志缓冲与来源过滤 ====
    // 服务端日志行格式: [时间] |级别| (来源) 消息
    const logStore = [];          // { line, src }
    let logSourceFilter = '';

    function logSourceOf(line) {
        const m = line.match(/^\[[^\]]*\]\s*\|[^|]*\|\s*\(([^)]*)\)/);
        return m ? m[1] : '';
    }

    // 一次性渲染当前可见日志: 交给 RtLog 做级别着色 + 多行错误(堆栈)合并,
    // 逐行 append 无法知道下一行是不是堆栈续行, 会把错误拆散。
    function renderLogs() {
        const panel = document.getElementById('logPanel');
        // 整批重绘会重置滚动位置: 记录是否贴底, 贴底才自动跟随, 否则保持原位置
        const prevTop = panel.scrollTop;
        const atBottom = panel.scrollHeight - panel.scrollTop - panel.clientHeight < 40;
        let shown = logStore.filter(e => !logSourceFilter || e.src === logSourceFilter);
        shown = shown.slice(-500);
        if (shown.length === 0) {
            panel.innerHTML = '<div class="text-muted p-2">' + (logSourceFilter ? '该来源暂无日志' : '等待日志...') + '</div>';
            return;
        }
        if (window.RtLog) {
            panel.innerHTML = RtLog.render(shown.map(e => e.line));
        } else {
            panel.innerHTML = shown.map(function (e) {
                var d = document.createElement('div');
                d.textContent = e.line;
                return d.innerHTML;
            }).join('<br>');
        }
        // 贴底才自动跟随; 用户向上翻查历史时保持原位置, 不被新日志顶走
        if (autoScroll && atBottom) panel.scrollTop = panel.scrollHeight;
        else panel.scrollTop = prevTop;
    }

    /// 来源下拉里没有的新来源自动补一个选项, 便于过滤任意来源
    function ensureSourceOption(src) {
        if (!src) return;
        const sel = document.getElementById('logSourceFilter');
        if (!sel) return;
        const exists = Array.prototype.some.call(sel.options, o => o.value === src);
        if (exists) return;
        const opt = document.createElement('option');
        opt.value = src;
        opt.textContent = src;
        sel.appendChild(opt);
    }

    function clearLogs() {
        logStore.length = 0;
        setAiThinking('');
        renderLogs();
    }

    function applyLogFilter() {
        logSourceFilter = document.getElementById('logSourceFilter').value;
        renderLogs();
    }

    function appendLog(line) {
        const src = logSourceOf(line);
        ensureSourceOption(src);
        // AI 思考内容(AiThink)实时替换 AI 卡片下方的说明文字
        if (src === 'AiThink') {
            const m = line.match(/\(AiThink\)\s*(.*)$/);
            setAiThinking(m ? m[1] : '');
        } else if (src === 'AiAuto' || src === 'AiTools' || src === 'AiAnalyze') {
            // AI 任务/工具调用/分析动作: 作为"活动"状态显示, 让卡片文字能反映自动化是否在工作
            const m = line.match(/\((?:AiAuto|AiTools|AiAnalyze)\)\s*(.*)$/);
            if (m && m[1]) setAiActivity(m[1]);
        }
        logStore.push({ line, src });
        if (logStore.length > 500) logStore.shift();
        scheduleRender();
    }

    // 批量追加日志时只在下一帧重绘一次: 逐行 renderLogs 会对 500 行做 500 次全量解析
    let logRenderPending = false;
    function scheduleRender() {
        if (logRenderPending) return;
        logRenderPending = true;
        const run = function () { logRenderPending = false; renderLogs(); };
        if (window.requestAnimationFrame) requestAnimationFrame(run);
        else setTimeout(run, 16);
    }

    // 首屏/切换实例时只回放末尾若干行, 避免整块缓冲区全量重放
    let logFirstFetch = true;
    let logDisconnectedNotified = false;
    let logPolling = false;   // 上一次轮询未返回时跳过, 防止请求堆积

    async function pollLogs() {
        if (logPolling) return;
        logPolling = true;
        try {
            const qs = (consoleInstanceId !== null && consoleInstanceId !== '')
                ? `&instanceId=${encodeURIComponent(consoleInstanceId)}` : '';
            const maxQs = logFirstFetch ? '&max=200' : '';
            const res = await fetch(`/api/console/logs?afterSeq=${lastLogSeq}${qs}${maxQs}`);
            if (res.ok) {
                const data = await res.json();
                logFirstFetch = false;
                if (data.lines && data.lines.length > 0) {
                    data.lines.forEach(line => appendLog(line));
                    lastLogSeq = data.latestSeq;
                } else if (data.latestSeq !== lastLogSeq) {
                    lastLogSeq = data.latestSeq;
                }
                if (data.connected === false) {
                    if (!logDisconnectedNotified) {
                        logDisconnectedNotified = true;
                        appendLog('[系统] 与服务器的连接已断开');
                    }
                } else {
                    logDisconnectedNotified = false;
                }
            }
        } catch (e) {
        } finally {
            logPolling = false;
        }
    }

    // ===== 实例选择(多实例并发) =====
    function switchConsoleInstance() {
        consoleInstanceId = document.getElementById('consoleInstanceFilter').value;
        // 切换实例后重新从缓冲区拉取该实例的日志(只拉末尾 200 行)
        logStore.length = 0;
        lastLogSeq = 0;
        logFirstFetch = true;
        logDisconnectedNotified = false;
        renderLogs();
        pollLogs();
    }

    async function loadInstanceFilter() {
        try {
            const instRes = await fetch('/api/instances/list').then(r => r.ok ? r.json() : null).catch(() => null);
            const sel = document.getElementById('consoleInstanceFilter');
            if (!sel) return;
            const currentKey = (instRes && instRes.currentServerKey) || '';
            const items = (instRes && instRes.success && Array.isArray(instRes.instances)) ? instRes.instances : [];

            let html = '<option value="">当前实例' + (currentKey ? ' (' + escapeHtmlSimple(currentKey) + ')' : '') + '</option>';
            items.forEach(function (i) {
                if (!i || !i.id) return;
                const suffix = i.id === currentKey ? '（当前）' : '';
                const name = i.name ? ' - ' + i.name : '';
                html += '<option value="' + escapeHtmlSimple(i.id) + '">'
                    + escapeHtmlSimple(i.id) + escapeHtmlSimple(name) + suffix + '</option>';
            });
            sel.innerHTML = html;

            // 首次加载: 默认选中 RtCli 当前实例, 清空已显示的其他实例日志
            if (consoleInstanceId === null) {
                consoleInstanceId = currentKey || '';
                sel.value = consoleInstanceId;
                logStore.length = 0;
                lastLogSeq = 0;
                logFirstFetch = true;
                renderLogs();
            } else {
                sel.value = consoleInstanceId || '';
            }
        } catch (e) { }
    }

    async function executeCommand() {
        const input = document.getElementById('cmdInput');
        const cmd = input.value.trim();
        if (!cmd) return;

        closeCmdDropdown();

        const btn = document.getElementById('execBtn');
        btn.disabled = true;

        appendLog(`> ${cmd}`);

        try {
            const res = await fetch('/api/console/execute', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ command: cmd, instanceId: consoleInstanceId || null })
            });
            const data = await res.json();
            if (!data.success) {
                appendLog(`[结果] ${data.message || data.result || '执行失败'}`);
            }
        } catch (e) {
            appendLog(`[错误] 请求失败: ${e.message}`);
        } finally {
            btn.disabled = false;
            input.value = '';
            input.focus();
        }

        // 添加到历史
        commandHistory.push(cmd);
        if (commandHistory.length > 100) commandHistory.shift();
        historyIndex = -1;
    }

    function quickCmd(cmd) {
        document.getElementById('cmdInput').value = cmd;
        executeCommand();
    }

    // 当前任务弹窗状态
    let currentTaskType = '';

    // 通过 API 获取任务列表并显示在弹窗中
    async function showTaskInfo(taskType, title) {
        currentTaskType = taskType;
        const modal = document.getElementById('taskInfoModal');
        const titleEl = document.getElementById('taskInfoTitle');
        const statusEl = document.getElementById('taskInfoStatus');
        const contentEl = document.getElementById('taskInfoContent');
        titleEl.textContent = title || taskType;
        statusEl.className = 'badge bg-secondary';
        statusEl.textContent = '加载中...';
        contentEl.innerHTML = '<span class="text-muted">正在获取任务列表...</span>';
        modal.style.display = 'flex';
        await refreshTaskInfo();
    }

    async function refreshTaskInfo() {
        if (!currentTaskType) return;
        const statusEl = document.getElementById('taskInfoStatus');
        const contentEl = document.getElementById('taskInfoContent');
        try {
            const resp = await fetch(`/api/system/tasks/${currentTaskType}`).then(r => r.json());
            if (resp.success) {
                statusEl.className = resp.isRunning ? 'badge bg-success' : 'badge bg-secondary';
                statusEl.textContent = resp.isRunning ? '运行中' : '已停止';
                contentEl.innerHTML = renderTaskTable(resp.tasks || [], currentTaskType);
            } else {
                statusEl.className = 'badge bg-danger';
                statusEl.textContent = '失败';
                contentEl.innerHTML = '<span class="text-danger">' + escapeHtmlSimple(resp.message || '获取失败') + '</span>';
            }
        } catch (e) {
            contentEl.innerHTML = '<span class="text-danger">请求失败: ' + escapeHtmlSimple(e.message) + '</span>';
        }
    }

    function renderTaskTable(tasks, type) {
        if (tasks.length === 0) return '<div class="text-muted text-center py-3">无任务</div>';
        let html = '<table class="table table-sm table-hover align-middle mb-0" style="font-size:13px;">';
        if (type === 'ai') {
            html += '<thead><tr><th>#</th><th>标识</th><th>名称</th><th>状态</th><th>触发条件</th><th>间隔Cron</th><th>动作</th><th>已执行</th><th>最后运行</th></tr></thead><tbody>';
            tasks.forEach((t, i) => {
                const cls = t.status === '启用' ? 'bg-success' : 'bg-secondary';
                html += `<tr><td>${i+1}</td><td><strong>${escapeHtmlSimple(t.key)}</strong></td><td>${escapeHtmlSimple(t.name)}</td><td><span class="badge ${cls}">${escapeHtmlSimple(t.status)}</span></td><td class="text-muted">${escapeHtmlSimple(t.trigger)}</td><td class="text-muted">${escapeHtmlSimple(t.interval)}</td><td class="text-muted">${escapeHtmlSimple(t.execute)}</td><td>${t.runCount}</td><td class="text-muted">${escapeHtmlSimple(t.lastRun)}</td></tr>`;
            });
        } else {
            html += '<thead><tr><th>#</th><th>标识</th><th>状态</th><th>触发条件</th><th>前置条件</th><th>执行内容</th><th>已执行</th></tr></thead><tbody>';
            tasks.forEach((t, i) => {
                let cls = 'bg-secondary';
                if (t.status === '启用') cls = 'bg-success';
                else if (t.status === '不适用') cls = 'bg-warning text-dark';
                else if (t.status === '已过期' || t.status === '已完成') cls = 'bg-danger';
                html += `<tr><td>${i+1}</td><td><strong>${escapeHtmlSimple(t.key)}</strong></td><td><span class="badge ${cls}">${escapeHtmlSimple(t.status)}</span></td><td class="text-muted">${escapeHtmlSimple(t.trigger)}</td><td class="text-muted">${escapeHtmlSimple(t.interval)}</td><td class="text-muted">${escapeHtmlSimple(t.execute)}</td><td>${t.runCount}</td></tr>`;
            });
        }
        html += '</tbody></table>';
        return html;
    }

    function escapeHtmlSimple(s) {
        return (s ?? '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // 带确认的操作按钮(用于停止/启动等不可逆操作)
    async function confirmCmd(cmd, msg) {
        if (msg && !await RtPanel.showConfirm('操作确认', msg)) return;
        document.getElementById('cmdInput').value = cmd;
        executeCommand();
    }

    // 重要操作按钮(默认带确认)
    async function actionCmd(cmd, msg) {
        if (msg && !await RtPanel.showConfirm('操作确认', msg)) return;
        document.getElementById('cmdInput').value = cmd;
        executeCommand();
    }

    // ===== 命令补全下拉框：候选计算 =====
    // 根据当前输入决定"补命令"还是"补参数"。
    // 规则：先求已输入部分里匹配到的最长完整命令链(词边界精确匹配)；
    //       若该命令是带参数的叶子命令且已进入参数区(有尾随空格或多输入了词)，则补参数，否则补命令。
    function computeCandidates(rawInput) {
        const input = rawInput || '';
        const trimmed = input.replace(/^\s+/, '').replace(/\s+$/, '');
        const hasTrailingSpace = /\s$/.test(input);
        const tokens = trimmed ? trimmed.split(/\s+/) : [];

        let matchedCmd = null;
        let matchedLen = 0;
        for (let len = tokens.length; len >= 1; len--) {
            const cand = tokens.slice(0, len).join(' ').toLowerCase();
            if (knownCommandSet.has(cand)) {
                matchedCmd = cand;
                matchedLen = len;
                break;
            }
        }

        // 参数补全位置
        if (matchedCmd && PARAM_SPECS[matchedCmd] && (hasTrailingSpace || tokens.length > matchedLen)) {
            const prefix = tokens.slice(0, matchedLen).join(' ');
            const argPartial = tokens.length > matchedLen ? tokens.slice(matchedLen).join(' ') : '';
            return buildParamCandidates(matchedCmd, prefix, argPartial);
        }

        // 命令补全：以当前输入为前缀匹配命令全集
        const lower = trimmed.toLowerCase();
        const seen = new Set();
        const out = [];
        for (const c of availableCommands) {
            const cmd = c && c.command;
            if (!cmd) continue;
            const key = cmd.toLowerCase();
            if (lower && !key.startsWith(lower)) continue;
            if (seen.has(key)) continue;
            seen.add(key);
            out.push({ value: cmd, description: c.description || '', isCommand: true });
        }
        return out;
    }

    function buildParamCandidates(cmd, prefix, argPartial) {
        const values = getParamValues(PARAM_SPECS[cmd]);
        const p = (argPartial || '').toLowerCase();
        const seen = new Set();
        const out = [];
        for (const v of values) {
            if (!v) continue;
            const key = v.toLowerCase();
            if (p && !key.startsWith(p)) continue;
            if (seen.has(key)) continue;
            seen.add(key);
            out.push({ value: prefix + ' ' + v, description: '', isCommand: false });
        }
        return out;
    }

    // 参数数据源：懒加载一次并缓存，失败静默
    function getParamValues(type) {
        if (!type) return [];
        if (paramCache[type] !== null) return paramCache[type];
        loadParamValues(type);
        return [];
    }

    async function loadParamValues(type) {
        if (!type || paramLoading[type] || paramCache[type] !== null) return;
        paramLoading[type] = true;
        try {
            if (type === 'instance') {
                const d = await fetch('/api/instances/list').then(r => r.ok ? r.json() : null).catch(() => null);
                paramCache[type] = (d && d.success && Array.isArray(d.instances))
                    ? d.instances.map(i => i.id).filter(Boolean) : [];
            } else if (type === 'extension') {
                const d = await fetch('/api/extensions').then(r => r.ok ? r.json() : null).catch(() => null);
                paramCache[type] = Array.isArray(d) ? d.map(e => e.key).filter(Boolean) : [];
            } else if (type === 'aiTask') {
                const d = await fetch('/api/system/tasks/ai').then(r => r.ok ? r.json() : null).catch(() => null);
                paramCache[type] = (d && d.success && Array.isArray(d.tasks))
                    ? d.tasks.map(t => t.key).filter(Boolean) : [];
            } else {
                paramCache[type] = [];
            }
        } catch (e) {
            paramCache[type] = [];
        } finally {
            paramLoading[type] = false;
            // 数据就绪后，若输入框仍聚焦且当前输入产生候选，则刷新/展开下拉
            maybeReopenDropdown();
        }
    }

    // ===== 命令补全下拉框：渲染与显隐 =====
    function rebuildCandidates() {
        cmdCandidates = computeCandidates(document.getElementById('cmdInput').value);
    }

    function openCmdDropdown() {
        document.getElementById('cmdDropdown').hidden = false;
        cmdDropdownOpen = true;
    }

    function closeCmdDropdown() {
        document.getElementById('cmdDropdown').hidden = true;
        cmdDropdownOpen = false;
        cmdHighlightIndex = -1;
    }

    function renderCandidates() {
        const dd = document.getElementById('cmdDropdown');
        if (!cmdCandidates.length) {
            dd.innerHTML = '<div class="jar-dropdown-empty">无匹配项</div>';
            return;
        }
        let html = '';
        cmdCandidates.forEach((c, i) => {
            const activeStyle = i === cmdHighlightIndex
                ? ' style="background-color:var(--bg-card-hover);color:var(--accent);"'
                : '';
            html += '<div class="jar-dropdown-item" data-idx="' + i + '"' + activeStyle + '>'
                + '<span>' + escapeHtmlSimple(c.value) + '</span>'
                + (c.description
                    ? '<span class="text-muted ms-2" style="font-size:.68rem;">' + escapeHtmlSimple(c.description) + '</span>'
                    : '')
                + '</div>';
        });
        dd.innerHTML = html;
    }

    function scrollHighlightIntoView() {
        const dd = document.getElementById('cmdDropdown');
        const el = dd.querySelector('.jar-dropdown-item[data-idx="' + cmdHighlightIndex + '"]');
        if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
    }

    // 参数数据懒加载完成后，尝试按当前输入重新展开下拉
    function maybeReopenDropdown() {
        const input = document.getElementById('cmdInput');
        if (document.activeElement !== input) return;
        rebuildCandidates();
        if (cmdCandidates.length > 0) {
            if (cmdHighlightIndex < 0) cmdHighlightIndex = 0;
            openCmdDropdown();
            renderCandidates();
        } else {
            closeCmdDropdown();
        }
    }

    function moveHighlight(delta) {
        if (!cmdCandidates.length) return;
        if (cmdHighlightIndex < 0) cmdHighlightIndex = 0;
        else cmdHighlightIndex = (cmdHighlightIndex + delta + cmdCandidates.length) % cmdCandidates.length;
        renderCandidates();
        scrollHighlightIntoView();
    }

    // 点击/填充候选（命令补命令补一个尾随空格，便于继续输入参数）
    function fillCandidate(c) {
        if (!c) return;
        document.getElementById('cmdInput').value = c.isCommand ? c.value + ' ' : c.value;
    }

    // 点击候选项：填充、收起、焦点回到输入框
    function selectCandidate(idx) {
        const c = cmdCandidates[idx];
        if (!c) return;
        const input = document.getElementById('cmdInput');
        fillCandidate(c);
        input.focus();
        closeCmdDropdown();
    }

    // TAB 补全：下拉不可见则先展开；可见则用高亮项填充并高亮下一项(可循环)
    function handleTab(e) {
        e.preventDefault();
        const input = document.getElementById('cmdInput');
        if (!cmdDropdownOpen || cmdCandidates.length === 0) {
            rebuildCandidates();
            if (cmdCandidates.length > 0) {
                cmdHighlightIndex = 0;
                openCmdDropdown();
                renderCandidates();
                scrollHighlightIntoView();
            }
            return;
        }
        const idx = cmdHighlightIndex < 0 ? 0 : cmdHighlightIndex;
        fillCandidate(cmdCandidates[idx]);
        cmdHighlightIndex = (idx + 1) % cmdCandidates.length;
        renderCandidates();
        scrollHighlightIntoView();
    }

    // 输入时自动展开(不修改输入、不阻止默认、不抢焦点)
    document.getElementById('cmdInput').addEventListener('input', function () {
        rebuildCandidates();
        if (cmdCandidates.length > 0) {
            cmdHighlightIndex = 0;
            openCmdDropdown();
            renderCandidates();
            scrollHighlightIntoView();
        } else {
            closeCmdDropdown();
        }
    });

    // 右侧展开按钮：切换下拉显隐
    document.getElementById('cmdExpandBtn').addEventListener('mousedown', function (e) {
        e.preventDefault(); // 保持输入框焦点，避免 blur 收起
        const input = document.getElementById('cmdInput');
        if (cmdDropdownOpen) {
            closeCmdDropdown();
        } else {
            rebuildCandidates();
            cmdHighlightIndex = cmdCandidates.length ? 0 : -1;
            renderCandidates();
            openCmdDropdown();
            input.focus();
            scrollHighlightIntoView();
        }
    });

    // 候选项选中：用 mousedown + preventDefault，避免先触发 blur 收起
    document.getElementById('cmdDropdown').addEventListener('mousedown', function (e) {
        const item = e.target.closest('.jar-dropdown-item');
        if (!item) return;
        e.preventDefault();
        selectCandidate(parseInt(item.dataset.idx, 10));
    });

    // 点击输入区/下拉框以外区域 → 收起
    document.addEventListener('mousedown', function (e) {
        if (!cmdDropdownOpen) return;
        const wrap = document.querySelector('.jar-select');
        const btn = document.getElementById('cmdExpandBtn');
        if (wrap && wrap.contains(e.target)) return;
        if (btn && (e.target === btn || btn.contains(e.target))) return;
        closeCmdDropdown();
    });

    // 输入框失焦 → 收起
    document.getElementById('cmdInput').addEventListener('blur', function () {
        closeCmdDropdown();
    });

    // 命令历史导航 + 下拉框键盘操作
    document.getElementById('cmdInput').addEventListener('keydown', function (e) {
        if (e.key === 'Tab') {
            handleTab(e);
            return;
        } else if (e.key === 'Escape') {
            if (cmdDropdownOpen) {
                e.preventDefault();
                closeCmdDropdown();
            }
            return;
        } else if (e.key === 'Enter') {
            if (cmdDropdownOpen) closeCmdDropdown();
            executeCommand();
            return;
        } else if (e.key === 'ArrowUp') {
            if (cmdDropdownOpen && cmdCandidates.length > 0) {
                e.preventDefault();
                moveHighlight(-1);
                return;
            }
            e.preventDefault();
            if (commandHistory.length > 0) {
                if (historyIndex === -1) historyIndex = commandHistory.length - 1;
                else if (historyIndex > 0) historyIndex--;
                this.value = commandHistory[historyIndex];
            }
            return;
        } else if (e.key === 'ArrowDown') {
            if (cmdDropdownOpen && cmdCandidates.length > 0) {
                e.preventDefault();
                moveHighlight(1);
                return;
            }
            e.preventDefault();
            if (historyIndex !== -1) {
                if (historyIndex < commandHistory.length - 1) {
                    historyIndex++;
                    this.value = commandHistory[historyIndex];
                } else {
                    historyIndex = -1;
                    this.value = '';
                }
            }
            return;
        }
    });

    // 加载命令列表用于自动补全
    async function loadCommands() {
        try {
            const res = await fetch('/api/console/commands');
            if (res.ok) {
                const commands = await res.json();
                availableCommands = [];
                knownCommandSet = new Set();
                if (Array.isArray(commands)) {
                    commands.forEach(c => {
                        if (!c || !c.command) return;
                        availableCommands.push({ command: c.command, description: c.description || '' });
                        knownCommandSet.add(c.command.toLowerCase());
                    });
                    availableCommands.sort((a, b) => a.command.localeCompare(b.command));
                }
            }
        } catch (e) { }
    }

    // ===== AI 自动化状态 =====
    let aiRunningState = false;
    const AI_TAGLINE = '自动守护服务运行 · 智能分析错误日志 · 自动执行运维任务';
    let aiThinkingText = '';
    let aiActivityText = '';

    // 优先显示 AI 思考内容; 无思考时显示最近一条自动化活动(状态), 否则回退默认文案
    function refreshAiTagline() {
        const el = document.getElementById('aiHeroTagline');
        if (!el) return;
        if (aiThinkingText) {
            el.textContent = '思考：' + aiThinkingText;
            el.classList.add('ai-thinking');
        } else if (aiActivityText && aiRunningState) {
            el.textContent = '活动：' + aiActivityText;
            el.classList.add('ai-thinking');
        } else {
            el.textContent = AI_TAGLINE;
            el.classList.remove('ai-thinking');
        }
    }

    // 有 AI 思考内容时替换标题下方的说明文字, 没有时回退到默认文案
    function setAiThinking(text) {
        aiThinkingText = (text || '').trim();
        refreshAiTagline();
    }

    // 最近一次自动化活动(任务触发/工具调用/分析完成), 让卡片文字能反映当前状态
    function setAiActivity(text) {
        aiActivityText = (text || '').trim();
        refreshAiTagline();
    }

    function aiHeroToggle() {
        if (aiRunningState) {
            confirmCmd('.ai stop', '确定停止AI自动化管理？');
        } else {
            actionCmd('.ai start', '启动AI自动化管理？将自动启动MC服务端并开始无人管理。');
        }
    }

    function updateAiHeroStatus(running) {
        aiRunningState = !!running;
        const card = document.getElementById('aiHeroCard');
        const text = document.getElementById('aiStatusText');
        const badge = document.getElementById('aiStatusBadge');
        const btn = document.getElementById('aiHeroToggleBtn');
        if (!card || !text || !badge || !btn) return;
        card.classList.toggle('running', aiRunningState);
        badge.classList.toggle('running', aiRunningState);
        text.textContent = aiRunningState ? '运行中' : '已停止';
        btn.classList.toggle('stop', aiRunningState);
        btn.innerHTML = aiRunningState ? '■ 停止 AI 自动化' : '▶ 启动 AI 自动化';
        // 停止后清空动态思考文字, 恢复默认说明
        if (!aiRunningState) { aiActivityText = ''; setAiThinking(''); }
    }

    // 加载连接信息(表格形式)
    let connInfoLoading = false;
    async function loadConnInfo() {
        if (connInfoLoading) return;   // 上一次请求未返回时跳过, 避免慢统计接口导致请求堆积
        connInfoLoading = true;
        try {
            const [authRes, statsRes] = await Promise.all([
                fetch('/api/auth/status').then(r => r.ok ? r.json() : null).catch(() => null),
                fetch('/api/system/stats').then(r => r.ok ? r.json() : null).catch(() => null)
            ]);
            const el = document.getElementById('connInfo');
            if (!authRes || !authRes.connected) {
                el.innerHTML = '<div class="text-danger text-center py-2">未连接</div>';
                updateAiHeroStatus(false);
                return;
            }

            const stats = statsRes || {};
            const currentKey = stats.currentServerKey || '-';
            const servers = stats.servers || [];
            const aiRunning = stats.aiRunning;
            const schedRunning = stats.schedulerRunning;
            const mcRunning = servers.some(s => s.isRunning);

            // 启动按钮按"当前选中的实例"置灰: 该实例已运行则禁用, 防止重复启动
            const autoStartBtn = document.getElementById('autoStartBtn');
            const serverStartBtn = document.getElementById('serverStartBtn');
            const selectedKey = consoleInstanceId || currentKey;
            const selectedServer = servers.find(s => s.serverKey === selectedKey);
            if (autoStartBtn) autoStartBtn.disabled = !!schedRunning;
            if (serverStartBtn) serverStartBtn.disabled = selectedServer ? !!selectedServer.isRunning : !!mcRunning;

            updateAiHeroStatus(aiRunning);

            let html = '<table class="table table-sm table-borderless mb-0" style="font-size:13px;">';
            // 基本信息
            html += `<tr><td class="text-muted" style="width:100px;">服务器标识</td><td><strong class="text-info">${escapeHtmlSimple(currentKey)}</strong></td></tr>`;
            html += `<tr><td class="text-muted">服务器名称</td><td><strong>${escapeHtmlSimple(authRes.serverName || '-')}</strong></td></tr>`;
            html += `<tr><td class="text-muted">RtCli 版本</td><td>${escapeHtmlSimple(authRes.version || '-')}</td></tr>`;
            html += `<tr><td class="text-muted">连接地址</td><td>${escapeHtmlSimple(authRes.host || '-')}:${authRes.port || '-'}</td></tr>`;
            html += `<tr><td class="text-muted">面板连接数</td><td>${authRes.connectedClientCount ?? 0}</td></tr>`;
            html += `<tr><td class="text-muted">扩展数量</td><td>${authRes.extensionCount ?? 0}</td></tr>`;
            html += `<tr><td class="text-muted">AI 自动化</td><td>${aiRunning ? '<span class="badge bg-success">运行中</span>' : '<span class="badge bg-secondary">已停止</span>'}</td></tr>`;
            html += `<tr><td class="text-muted">调度器</td><td>${schedRunning ? '<span class="badge bg-success">运行中</span>' : '<span class="badge bg-secondary">已停止</span>'}</td></tr>`;
            html += '</table>';

            // 所有服务器运行状态
            if (servers.length > 0) {
                html += '<div class="mt-2 mb-1 small text-info fw-bold">所有服务器运行状态</div>';
                html += '<table class="table table-sm table-hover align-middle mb-0" style="font-size:12px;">';
                html += '<thead><tr><th>标识</th><th>名称</th><th>状态</th><th class="text-center">玩家</th><th class="text-center">TPS</th></tr></thead><tbody>';
                for (const s of servers) {
                    const isCurrent = s.serverKey === currentKey;
                    const statusBadge = s.isRunning
                        ? '<span class="badge bg-success">运行</span>'
                        : '<span class="badge bg-secondary">停止</span>';
                    const playerCell = s.isRunning && s.playerCount >= 0
                        ? `${s.playerCount}/${s.playerMax >= 0 ? s.playerMax : '?'}`
                        : '-';
                    const tpsCell = s.isRunning && s.tps1m >= 0 ? s.tps1m.toFixed(1) : '-';
                    html += `<tr${isCurrent ? ' class="table-active"' : ''}><td><strong>${escapeHtmlSimple(s.serverKey)}</strong>${isCurrent ? ' <span class="text-info">●</span>' : ''}</td><td>${escapeHtmlSimple(s.serverName)}</td><td>${statusBadge}</td><td class="text-center">${playerCell}</td><td class="text-center">${tpsCell}</td></tr>`;
                }
                html += '</tbody></table>';
            }

            el.innerHTML = html;
        } catch (e) {
        } finally {
            connInfoLoading = false;
        }
    }

    // 初始化
    loadCommands();
    loadInstanceFilter();
    loadConnInfo();
    setInterval(pollLogs, 1000);
    // 连接信息刷新速度跟随"设置"页的刷新间隔(最低 500ms), 不在本页写死
    fetch('/api/system/paneldata').then(r => r.ok ? r.json() : null).catch(() => null).then(data => {
        const v = parseInt(data && data.refreshInterval, 10);
        setInterval(loadConnInfo, v >= 500 ? v : 5000);
    });
    setInterval(loadInstanceFilter, 15000);
    document.getElementById('cmdInput').focus();
</script>

<style>
    /* ===== AI 自动化功能卡片（MC 方块风·草绿主题） ===== */
    .ai-hero-card { position: relative; border-radius: 0; color: var(--text-primary, #ecebe4); border: 2px solid var(--btn-outline, #0c0c12); outline: 1px solid rgba(74, 222, 128, 0.35); outline-offset: -5px; background: linear-gradient(180deg, rgba(74, 222, 128, 0.10), rgba(56, 189, 248, 0.04)), var(--bg-card, #1f1f28); box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35); transition: outline-color 0.2s, box-shadow 0.2s; }
    .ai-hero-card.running { outline-color: rgba(74, 222, 128, 0.8); box-shadow: 4px 4px 0 rgba(74, 222, 128, 0.35); }
    .ai-hero-icon { font-size: 1.6rem; line-height: 1; filter: drop-shadow(2px 2px 0 rgba(0, 0, 0, 0.5)); }
    .ai-hero-title { font-size: 1.05rem; font-weight: 700; font-family: var(--font-pixel, sans-serif); letter-spacing: 0.5px; color: var(--color-success, #4ade80); text-shadow: 0 0 12px rgba(74, 222, 128, 0.4); }
    .ai-hero-btn { border: 2px solid var(--color-success, #4ade80) !important; border-radius: 0; padding: 10px 12px; font-weight: 700; font-family: var(--font-pixel, sans-serif); color: var(--color-success, #4ade80); background: transparent; box-shadow: none; text-shadow: none; transition: background 0.12s, color 0.12s, border-color 0.12s; }
    .ai-hero-btn:hover { background: rgba(74, 222, 128, 0.12); color: var(--color-success, #4ade80); border-color: var(--color-success, #4ade80) !important; filter: none; }
    .ai-hero-btn:active { transform: translateY(1px); }
    .ai-hero-btn.stop { color: var(--color-danger, #f05252); border-color: var(--color-danger, #f05252) !important; background: transparent; text-shadow: none; }
    .ai-hero-btn.stop:hover { background: rgba(240, 82, 82, 0.12); color: var(--color-danger, #f05252); border-color: var(--color-danger, #f05252) !important; }
    .ai-status-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; font-family: var(--font-pixel, sans-serif); padding: 3px 10px; border-radius: 0; background: var(--bg-input, #16161e); color: var(--text-secondary, #a8a89b); border: 2px solid var(--border-color, #3a3a49); }
    .ai-status-badge.running { color: var(--color-success, #4ade80); border-color: var(--color-success, #4ade80); }
    .ai-status-dot { width: 8px; height: 8px; border-radius: 0; background: #6b6b78; display: inline-block; }
    .ai-status-badge.running .ai-status-dot { background: var(--color-success, #4ade80); animation: aiPulse 1.6s infinite; }
    .ai-hero-tagline { transition: color 0.2s; }
    .ai-hero-tagline.ai-thinking { color: var(--color-info, #38bdf8) !important; animation: aiThinkFade 1.8s ease-in-out infinite; }
    @@keyframes aiThinkFade { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
    @@keyframes aiPulse { 0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55); } 70% { box-shadow: 0 0 0 8px rgba(74, 222, 128, 0); } 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); } }

    /* 亮色主题适配 */
    [data-theme="light"] .ai-hero-card { color: var(--text-primary, #26241c); background: linear-gradient(180deg, rgba(74, 222, 128, 0.10), rgba(56, 189, 248, 0.05)), var(--bg-card, #faf9f3); box-shadow: 4px 4px 0 rgba(90, 80, 50, 0.15); }
    [data-theme="light"] .ai-hero-title { color: #16a34a; text-shadow: none; }
    [data-theme="light"] .ai-hero-btn { color: #fff; text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25); background: linear-gradient(180deg, #22c55e, #16a34a 55%, #15803d); border-color: #55503f; }
    [data-theme="light"] .ai-hero-btn.stop { background: linear-gradient(180deg, #ef4444, #dc2626 55%, #b91c1c); }
    [data-theme="light"] .ai-status-badge { background: var(--bg-input, #fff); color: var(--text-secondary, #565246); border-color: var(--border-color, #c9c5b4); }
    [data-theme="light"] .ai-status-badge.running { color: #16a34a; border-color: #16a34a; }
</style>
}
