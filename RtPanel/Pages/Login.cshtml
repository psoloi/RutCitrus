@page
@model RtPanel.Pages.LoginModel
@{
    ViewData["Title"] = "登录";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登录 - RtPanel</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: var(--bg-page);
            background-image:
                radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(14, 165, 233, 0.08) 0px, transparent 50%);
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-primary);
        }
        .login-card {
            background: rgba(18, 34, 54, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 12px 50px rgba(0,0,0,0.6), 0 0 0 1px rgba(56, 189, 248, 0.08);
        }
        .login-card .brand {
            text-align: center;
            margin-bottom: 8px;
        }
        .login-card .brand .logo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: linear-gradient(135deg, #38bdf8, #0ea5e9);
            color: #0a1424;
            font-size: 1.6rem;
            font-weight: 800;
            margin-bottom: 12px;
            box-shadow: 0 4px 16px rgba(56, 189, 248, 0.35);
        }
        .login-card h1 {
            color: var(--accent);
            font-size: 1.6rem;
            margin-bottom: 4px;
            text-align: center;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .login-card .subtitle {
            color: var(--text-muted);
            text-align: center;
            margin-bottom: 28px;
            font-size: 0.85rem;
        }
        .login-card label {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-bottom: 4px;
            font-weight: 500;
        }
        .login-card .form-control {
            background-color: var(--bg-input);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 8px;
            padding: 10px 14px;
        }
        .login-card .form-control:focus {
            background-color: var(--bg-input);
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
            color: var(--text-primary);
        }
        .login-card .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-hover));
            border: none;
            border-radius: 8px;
            padding: 11px;
            font-weight: 600;
            width: 100%;
            color: #0a1424;
            box-shadow: 0 4px 12px rgba(56, 189, 248, 0.25);
            transition: all 0.2s;
        }
        .login-card .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(56, 189, 248, 0.4);
        }
        .login-card .btn-primary:disabled {
            background: #2a3b54;
            color: var(--text-muted);
            box-shadow: none;
            transform: none;
        }
        .alert-error {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.85rem;
            display: none;
        }
        .port-input-group {
            display: flex;
            gap: 8px;
        }
        .port-input-group .host { flex: 1; }
        .port-input-group .port { width: 100px; }
        .login-card .footer-note {
            text-align: center;
            margin-top: 20px;
            color: var(--text-muted);
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <div class="logo">Rt</div>
        </div>
        <h1>RtPanel</h1>
        <p class="subtitle">RutCitrus 管理面板 - 请输入连接信息登录</p>

        <div id="errorMsg" class="alert-error mb-3"></div>

        <form id="loginForm" onsubmit="return false;">
            <div class="mb-3">
                <label class="d-block">gRPC 地址与端口</label>
                <div class="port-input-group">
                    <input type="text" class="form-control host" id="host" value="127.0.0.1" placeholder="主机地址" />
                    <input type="number" class="form-control port" id="port" value="7789" placeholder="端口" />
                </div>
            </div>
            <div class="mb-3">
                <label>认证密钥</label>
                <input type="password" class="form-control" id="authKey" placeholder="输入 gRPC 认证密钥" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-primary" id="loginBtn" onclick="doLogin()">
                <span id="btnText">登录</span>
                <span id="btnSpinner" class="spinner-border spinner-border-sm ms-1" role="status" style="display:none;"></span>
            </button>
        </form>
        <div class="footer-note">连接到运行 RtCli 的服务器以开始管理</div>
    </div>

    <script>
        async function doLogin() {
            const host = document.getElementById('host').value.trim();
            const port = parseInt(document.getElementById('port').value) || 7789;
            const authKey = document.getElementById('authKey').value.trim();
            const errorMsg = document.getElementById('errorMsg');
            const btn = document.getElementById('loginBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');

            if (!host) { errorMsg.textContent = '请输入主机地址'; errorMsg.style.display = 'block'; return; }
            if (!authKey) { errorMsg.textContent = '请输入认证密钥'; errorMsg.style.display = 'block'; return; }

            btn.disabled = true;
            btnText.textContent = '连接中...';
            btnSpinner.style.display = 'inline-block';
            errorMsg.style.display = 'none';

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ host, port, authKey })
                });
                const data = await res.json();

                if (data.success) {
                    window.location.href = '/Console';
                } else {
                    errorMsg.textContent = data.message || '登录失败';
                    errorMsg.style.display = 'block';
                }
            } catch (e) {
                errorMsg.textContent = '网络错误: ' + e.message;
                errorMsg.style.display = 'block';
            } finally {
                btn.disabled = false;
                btnText.textContent = '登录';
                btnSpinner.style.display = 'none';
            }
        }

        document.getElementById('authKey').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') doLogin();
        });
    </script>
</body>
</html>
