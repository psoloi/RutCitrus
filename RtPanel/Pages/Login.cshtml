@page
@model RtPanel.Pages.LoginModel
@{
    ViewData["Title"] = "登录";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登录 - RtPanel</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--bg-page);
            background-image:
                radial-gradient(at 0% 0%, var(--glow-a, rgba(249,115,22,0.05)) 0px, transparent 55%),
                radial-gradient(at 100% 100%, var(--glow-b, rgba(56,189,248,0.045)) 0px, transparent 55%),
                linear-gradient(var(--grid-line, rgba(160,170,200,0.045)) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-line, rgba(160,170,200,0.045)) 1px, transparent 1px);
            background-size: auto, auto, 28px 28px, 28px 28px;
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-primary);
        }
        .login-card {
            background: var(--bg-card, #1f1f28);
            border: 2px solid var(--btn-outline, #0c0c12);
            outline: 1px solid var(--border-color, #3a3a49);
            outline-offset: -6px;
            border-radius: 0;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 8px 8px 0 rgba(0,0,0,0.45);
        }
        .login-card .brand { text-align: center; margin-bottom: 8px; }
        /* 品牌像素方块 Logo：橙/天青 2x2 棋盘格 */
        .login-card .brand .logo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border: 2px solid var(--btn-outline, #0c0c12);
            background:
                linear-gradient(var(--accent-2, #38bdf8), var(--accent-2, #38bdf8)) no-repeat 4px 4px / 22px 22px,
                linear-gradient(var(--accent, #f97316), var(--accent, #f97316)) no-repeat 26px 4px / 22px 22px,
                linear-gradient(var(--accent, #f97316), var(--accent, #f97316)) no-repeat 4px 26px / 22px 22px,
                linear-gradient(var(--accent-2, #38bdf8), var(--accent-2, #38bdf8)) no-repeat 26px 26px / 22px 22px;
            background-color: var(--bg-input, #16161e);
            box-shadow: 4px 4px 0 rgba(0,0,0,0.45);
            margin-bottom: 14px;
            image-rendering: pixelated;
        }
        .login-card h1 {
            color: var(--text-primary);
            font-size: 1.7rem;
            margin-bottom: 4px;
            text-align: center;
            font-weight: 700;
            letter-spacing: 1px;
            font-family: var(--font-pixel, sans-serif);
        }
        .login-card h1 .brand-sky { color: var(--accent-2, #38bdf8); }
        .login-card .subtitle {
            color: var(--text-muted);
            text-align: center;
            margin-bottom: 28px;
            font-size: 0.85rem;
        }
        .login-card label {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-bottom: 4px;
            font-weight: 600;
        }
        .login-card .form-control {
            background-color: var(--bg-input);
            border: 2px solid var(--border-color);
            border-radius: 0;
            color: var(--text-primary);
            box-shadow: inset 2px 2px 0 rgba(0,0,0,0.25);
            padding: 10px 14px;
        }
        .login-card .form-control:focus {
            background-color: var(--bg-input);
            border-color: var(--accent);
            box-shadow: inset 2px 2px 0 rgba(0,0,0,0.25), 0 0 0 3px var(--accent-soft);
            color: var(--text-primary);
        }
        .login-card .btn-primary {
            background: linear-gradient(180deg, #fb923c, #f97316 55%, #e86a0c);
            border: 2px solid var(--btn-outline, #0c0c12);
            border-radius: 0;
            padding: 11px;
            font-weight: 700;
            width: 100%;
            color: #fff;
            font-family: var(--font-pixel, sans-serif);
            letter-spacing: 0.5px;
            text-shadow: 0 1px 0 rgba(0,0,0,0.35);
            box-shadow: inset 2px 2px 0 rgba(255,255,255,0.28), inset -2px -2px 0 rgba(0,0,0,0.42);
            transition: filter 0.12s, transform 0.05s, box-shadow 0.05s;
        }
        .login-card .btn-primary:hover:not(:disabled) { filter: brightness(1.12); color: #fff; }
        .login-card .btn-primary:active:not(:disabled) {
            transform: translateY(2px);
            box-shadow: inset 2px 2px 0 rgba(0,0,0,0.42), inset -2px -2px 0 rgba(255,255,255,0.28);
        }
        .login-card .btn-primary:disabled {
            background: var(--bg-card-hover, #2a2a35);
            color: var(--text-muted);
            filter: none;
            box-shadow: none;
            transform: none;
        }
        .alert-error {
            background: rgba(240, 82, 82, 0.1);
            border: 2px solid rgba(240, 82, 82, 0.45);
            color: #f8a3a3;
            border-radius: 0;
            padding: 10px 14px;
            font-size: 0.85rem;
            display: none;
        }
        .port-input-group { display: flex; gap: 8px; }
        .port-input-group .host { flex: 1; }
        .port-input-group .port { width: 100px; }
        .login-card .footer-note {
            text-align: center;
            margin-top: 20px;
            color: var(--text-muted);
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <div class="logo" aria-hidden="true"></div>
        </div>
        <h1>Rt<span class="brand-sky">Panel</span></h1>
        <p class="subtitle">RutCitrus 管理面板 - 请输入连接信息登录</p>

        <div id="errorMsg" class="alert-error mb-3"></div>

        <form id="loginForm" onsubmit="return false;">
            <div class="mb-3">
                <label class="d-block">gRPC 地址与端口</label>
                <div class="port-input-group">
                    <input type="text" class="form-control host" id="host" value="127.0.0.1" placeholder="主机地址" />
                    <input type="number" class="form-control port" id="port" value="7789" placeholder="端口" />
                </div>
            </div>
            <div class="mb-3">
                <label>认证密钥</label>
                <input type="password" class="form-control" id="authKey" placeholder="输入 gRPC 认证密钥" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-primary" id="loginBtn" onclick="doLogin()">
                <span id="btnText">登录</span>
                <span id="btnSpinner" class="spinner-border spinner-border-sm ms-1" role="status" style="display:none;"></span>
            </button>
            <button type="button" class="btn btn-warning mt-2 w-100" id="retrustBtn" style="display:none;" onclick="doLogin(true)">
                &#128273; 服务器证书已变更 - 重新信任并重连
            </button>
        </form>
        <div class="footer-note">连接到运行 RtCli 的服务器以开始管理</div>
    </div>

    <script>
        async function doLogin(retrust) {
            const host = document.getElementById('host').value.trim();
            const port = parseInt(document.getElementById('port').value) || 7789;
            const authKey = document.getElementById('authKey').value.trim();
            const errorMsg = document.getElementById('errorMsg');
            const btn = document.getElementById('loginBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const retrustBtn = document.getElementById('retrustBtn');

            if (!host) { errorMsg.textContent = '请输入主机地址'; errorMsg.style.display = 'block'; return; }
            if (!authKey) { errorMsg.textContent = '请输入认证密钥'; errorMsg.style.display = 'block'; return; }

            btn.disabled = true;
            btnText.textContent = '连接中...';
            btnSpinner.style.display = 'inline-block';
            errorMsg.style.display = 'none';
            retrustBtn.style.display = 'none';

            try {
                const csrf = document.querySelector('meta[name="csrf-token"]');
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrf ? csrf.getAttribute('content') : ''
                    },
                    body: JSON.stringify({ host, port, authKey, retrust: retrust === true })
                });
                const data = await res.json();

                if (!res.ok) {
                    errorMsg.textContent = `登录请求被拒绝 (HTTP ${res.status})：${data.title || data.detail || res.statusText}`;
                    errorMsg.style.display = 'block';
                    return;
                }

                if (data.success) {
                    window.location.href = '/Console';
                } else {
                    errorMsg.textContent = data.message || '登录失败';
                    errorMsg.style.display = 'block';
                    // 证书指纹不匹配时提供"重新信任"入口(确认安全后一键重连)
                    if (data.certMismatch) retrustBtn.style.display = 'block';
                }
            } catch (e) {
                errorMsg.textContent = '网络错误: ' + e.message;
                errorMsg.style.display = 'block';
            } finally {
                btn.disabled = false;
                btnText.textContent = '登录';
                btnSpinner.style.display = 'none';
            }
        }

        document.getElementById('authKey').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') doLogin();
        });
    </script>
</body>
</html>
