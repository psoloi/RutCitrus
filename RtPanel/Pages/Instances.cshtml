@page
@model RtPanel.Pages.InstancesModel
@{
    ViewData["Title"] = "实例";
}

<div class="instances-page">
    <!-- 顶部工具栏 -->
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input" id="selectAll" onchange="toggleSelectAll(this.checked)" />
                    <label class="form-check-label small" for="selectAll">全选</label>
                </div>
                <div class="vr"></div>
                <button class="btn btn-sm btn-outline-success" onclick="batchAction('start')" title="启动所有选中">开启</button>
                <button class="btn btn-sm btn-outline-danger" onclick="batchAction('stop')" title="停止所有选中">关闭</button>
                <button class="btn btn-sm btn-outline-warning" onclick="batchAction('restart')" title="重启所有选中">重启</button>
                <button class="btn btn-sm btn-outline-danger" onclick="batchDelete()" title="删除所有选中(需逐一确认)">删除</button>
                <div class="vr"></div>
                <button class="btn btn-sm btn-outline-info" onclick="openGroupWizard()" title="群组服务器一键构建向导(代理+端口+配置)">⚙ 创建群组服</button>
                <button class="btn btn-sm btn-primary" onclick="openInstanceWizard()">+ 创建新实例</button>
                <div class="ms-auto small text-muted">
                    <span id="instanceCount">0</span> 个实例 · <span id="groupCount">0</span> 个群组
                </div>
            </div>
        </div>
    </div>

    <!-- 群组列表区域 -->
    <div id="groupsContainer"></div>

    <!-- 独立实例区域 -->
    <div class="card bg-dark text-light border-secondary mb-3" id="standaloneCard" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>独立实例</span>
            <small class="text-muted">未加入群组的服务器</small>
        </div>
        <div class="card-body" id="standaloneContainer"></div>
    </div>

    <!-- 空状态 -->
    <div id="emptyState" class="text-center py-5 text-muted" style="display:none;">
        <div style="font-size:3rem;">📦</div>
        <p class="mt-3">暂无实例,点击右上角「+ 创建新实例」开始</p>
    </div>
</div>

<!-- 创建实例向导 -->
<div class="modal-overlay" id="instanceWizardModal" style="display:none;">
    <div class="modal-box" style="max-width:680px;">
        <h5 id="iwTitle">创建新实例向导</h5>
        <div class="wizard-steps mb-3" id="iwStepsBar">
            <span class="wizard-step active" data-step="1">1. 类型</span>
            <span class="wizard-step" data-step="2">2. 版本</span>
            <span class="wizard-step" data-step="3">3. 配置</span>
            <span class="wizard-step" data-step="4">4. 创建</span>
        </div>
        <div id="iwBody" style="min-height:280px;max-height:60vh;overflow-y:auto;"></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-sm btn-secondary" id="iwPrevBtn" onclick="iwPrev()">← 上一步</button>
            <div>
                <button class="btn btn-sm btn-secondary" onclick="closeModal('instanceWizardModal')">取消</button>
                <button class="btn btn-sm btn-primary" id="iwNextBtn" onclick="iwNext()">下一步 →</button>
            </div>
        </div>
    </div>
</div>

<!-- 群组构建向导 -->
<div class="modal-overlay" id="groupWizardModal" style="display:none;">
    <div class="modal-box" style="max-width:680px;">
        <h5 id="gwTitle">群组服务器构建向导</h5>
        <div class="wizard-steps mb-3" id="gwStepsBar">
            <span class="wizard-step active" data-step="1">1. 群组</span>
            <span class="wizard-step" data-step="2">2. 成员</span>
            <span class="wizard-step" data-step="3">3. 代理</span>
            <span class="wizard-step" data-step="4">4. 端口</span>
            <span class="wizard-step" data-step="5">5. 构建</span>
        </div>
        <div id="gwBody" style="min-height:280px;max-height:60vh;overflow-y:auto;"></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-sm btn-secondary" id="gwPrevBtn" onclick="gwPrev()">← 上一步</button>
            <div>
                <button class="btn btn-sm btn-secondary" onclick="closeModal('groupWizardModal')">取消</button>
                <button class="btn btn-sm btn-primary" id="gwNextBtn" onclick="gwNext()">下一步 →</button>
            </div>
        </div>
    </div>
</div>

<!-- 实例管理弹窗(详情+备份+配置) -->
<div class="modal-overlay" id="manageModal" style="display:none;">
    <div class="modal-box" style="max-width:720px;">
        <h5 id="manageTitle">实例管理</h5>
        <div id="manageContent"></div>
        <div class="text-end mt-3">
            <button class="btn btn-sm btn-secondary" onclick="closeModal('manageModal')">关闭</button>
        </div>
    </div>
</div>

<!-- 通用确认弹窗(用于删除确认) -->
<div class="modal-overlay" id="confirmModal" style="display:none;">
    <div class="modal-box" style="max-width:420px;">
        <h5 id="confirmTitle">确认</h5>
        <p id="confirmMsg" class="text-muted"></p>
        <div class="mb-3">
            <input type="text" class="form-control form-control-sm" id="confirmInput" placeholder="请输入服务器标识名称以确认" />
        </div>
        <div class="text-end">
            <button class="btn btn-sm btn-secondary" onclick="closeModal('confirmModal')">取消</button>
            <button class="btn btn-sm btn-danger" id="confirmBtn">确认删除</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // === 全局状态 ===
    let allInstances = [];
    let allGroups = [];
    let pendingDeleteQueue = []; // 批量删除队列

    // === 工具函数 ===
    function escapeHtml(s) {
        return (s ?? '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function showStatus(msg, type) {
        // 复用全局 toast
        if (window.RtPanel && RtPanel.showToast) { RtPanel.showToast(msg, type); return; }
        console.log(`[${type}] ${msg}`);
    }

    function openModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }

    function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes/1024).toFixed(1) + ' KB';
        if (bytes < 1073741824) return (bytes/1048576).toFixed(1) + ' MB';
        return (bytes/1073741824).toFixed(2) + ' GB';
    }

    // === 加载数据 ===
    async function loadInstances() {
        const resp = await fetch('/api/instances/list').then(r => r.json()).catch(() => ({ success: false }));
        if (!resp.success) {
            showStatus(resp.message || '加载失败', 'danger');
            return;
        }
        allInstances = resp.instances || [];
        allGroups = resp.groups || [];
        render();
    }

    // === 渲染 ===
    function render() {
        document.getElementById('instanceCount').textContent = allInstances.length;
        document.getElementById('groupCount').textContent = allGroups.length;

        const groupsContainer = document.getElementById('groupsContainer');
        const standaloneCard = document.getElementById('standaloneCard');
        const standaloneContainer = document.getElementById('standaloneContainer');
        const emptyState = document.getElementById('emptyState');

        groupsContainer.innerHTML = '';
        standaloneContainer.innerHTML = '';

        if (allInstances.length === 0 && allGroups.length === 0) {
            emptyState.style.display = '';
            standaloneCard.style.display = 'none';
            return;
        }
        emptyState.style.display = 'none';

        // 渲染群组
        allGroups.forEach(g => {
            const members = allInstances.filter(i => i.groupId === g.id);
            const card = document.createElement('div');
            card.className = 'card bg-dark text-light border-info mb-3';
            card.innerHTML = `
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 instance-group-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-info">${members.length}</span>
                        <strong>${escapeHtml(g.name)}</strong>
                        <small class="text-muted">群组 ID: ${escapeHtml(g.id)}</small>
                        <button class="btn btn-sm btn-outline-info py-0 px-1" title="用向导为此群组构建代理服务器" onclick="openGroupWizard('${g.id}')">建立群组服务器</button>
                    </div>
                    <div class="d-flex gap-1 flex-wrap">
                        <button class="btn btn-sm btn-outline-success" onclick="groupAction('${g.id}','start')" title="启动全部">▶ 全部启动</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="groupAction('${g.id}','stop')" title="停止全部">■ 全部停止</button>
                        <button class="btn btn-sm btn-outline-warning" onclick="groupAction('${g.id}','restart')" title="重启全部">⟳ 全部重启</button>
                        <button class="btn btn-sm btn-outline-info" onclick="showAddMemberModal('${g.id}')" title="添加成员">+ 添加</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="showManageGroupModal('${g.id}')" title="管理群组">管理</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="disbandGroup('${g.id}')" title="解散群组">解散</button>
                    </div>
                </div>
                <div class="card-body" id="group_${g.id}_body"></div>
            `;
            groupsContainer.appendChild(card);
            const body = card.querySelector(`#group_${g.id}_body`);
            members.forEach(inst => body.appendChild(renderInstanceRow(inst, g.id)));
            if (members.length === 0) {
                body.innerHTML = '<div class="text-muted small py-2">群组为空,点击「+ 添加」加入实例</div>';
            }
        });

        // 渲染独立实例
        const standalone = allInstances.filter(i => !i.groupId);
        if (standalone.length > 0) {
            standaloneCard.style.display = '';
            standalone.forEach(inst => standaloneContainer.appendChild(renderInstanceRow(inst, '')));
        } else {
            standaloneCard.style.display = 'none';
        }

        // 更新全选状态
        updateSelectAllState();
    }

    function renderInstanceRow(inst, groupId) {
        const row = document.createElement('div');
        row.className = 'instance-row d-flex align-items-center border rounded mb-2 p-2';
        row.dataset.id = inst.id;
        row.dataset.groupId = groupId;
        const statusBadge = inst.isRunning
            ? '<span class="badge bg-success">运行中</span>'
            : '<span class="badge bg-secondary">已停止</span>';
        row.innerHTML = `
            <div class="me-2">
                <input type="checkbox" class="form-check-input instance-check" data-id="${escapeHtml(inst.id)}" onchange="updateSelectAllState()" />
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2">
                    ${statusBadge}
                    <strong>${escapeHtml(inst.name)}</strong>
                    <small class="text-muted">${escapeHtml(inst.id)}</small>
                    ${inst.hidden ? '<span class="badge bg-warning text-dark">隐藏</span>' : ''}
                    ${inst.autoRestart ? '<span class="badge bg-info">自动重启</span>' : ''}
                </div>
                <small class="text-muted d-block">${escapeHtml(inst.workPath || '未配置工作目录')} · ${escapeHtml(inst.analyzerMode)}</small>
            </div>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-success instance-icon-btn" onclick="singleAction('${escapeHtml(inst.id)}','start')" title="启动" ${inst.isRunning?'disabled':''}>▶</button>
                <button class="btn btn-sm btn-outline-danger instance-icon-btn" onclick="singleAction('${escapeHtml(inst.id)}','stop')" title="停止" ${!inst.isRunning?'disabled':''}>■</button>
                <button class="btn btn-sm btn-outline-warning instance-icon-btn" onclick="singleAction('${escapeHtml(inst.id)}','restart')" title="重启">⟳</button>
                <a class="btn btn-sm btn-outline-info instance-icon-btn" href="/Instances/Manage/${encodeURIComponent(inst.id)}" title="管理">⚙</a>
            </div>
        `;
        return row;
    }

    // === 选择 ===
    function toggleSelectAll(checked) {
        document.querySelectorAll('.instance-check').forEach(cb => cb.checked = checked);
    }

    function updateSelectAllState() {
        const checks = document.querySelectorAll('.instance-check');
        const selectAll = document.getElementById('selectAll');
        if (checks.length === 0) { selectAll.checked = false; selectAll.indeterminate = false; return; }
        const checked = document.querySelectorAll('.instance-check:checked');
        selectAll.checked = checked.length === checks.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < checks.length;
    }

    function getSelectedIds() {
        return Array.from(document.querySelectorAll('.instance-check:checked')).map(cb => cb.dataset.id);
    }

    // === 单个操作 ===
    async function singleAction(id, action) {
        const resp = await fetch('/api/instances/action', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ action, ids: [id] })
        }).then(r => r.json());
        showStatus(resp.message || (resp.success ? '操作成功' : '操作失败'), resp.success ? 'success' : 'danger');
        if (resp.success) loadInstances();
    }

    // === 批量操作 ===
    async function batchAction(action) {
        const ids = getSelectedIds();
        if (ids.length === 0) { showStatus('请先选择实例', 'warning'); return; }
        const actionName = { start:'开启', stop:'关闭', restart:'重启' }[action] || action;
        if (!await confirmDialog(`批量${actionName}`, `确定对选中的 ${ids.length} 个实例执行「${actionName}」操作?`)) return;
        const resp = await fetch('/api/instances/action', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ action, ids })
        }).then(r => r.json());
        showStatus(resp.message || '操作完成', resp.success ? 'success' : 'danger');
        if (resp.success) loadInstances();
    }

    // === 批量删除(逐一确认) ===
    async function batchDelete() {
        const ids = getSelectedIds();
        if (ids.length === 0) { showStatus('请先选择实例', 'warning'); return; }
        if (!await confirmDialog('批量删除', `将删除选中的 ${ids.length} 个实例,每个需单独确认。是否开始?`)) return;
        pendingDeleteQueue = [...ids];
        processDeleteQueue();
    }

    async function processDeleteQueue() {
        if (pendingDeleteQueue.length === 0) {
            showStatus('批量删除完成', 'success');
            loadInstances();
            return;
        }
        const id = pendingDeleteQueue.shift();
        const inst = allInstances.find(i => i.id === id);
        const name = inst ? inst.name : id;

        // 要求用户输入标识名称确认
        document.getElementById('confirmTitle').textContent = `确认删除 (${pendingDeleteQueue.length + 1} 个剩余)`;
        document.getElementById('confirmMsg').textContent = `请输入服务器标识名称 "${id}" 以确认删除「${name}」。`;
        document.getElementById('confirmInput').value = '';
        document.getElementById('confirmInput').placeholder = `输入 ${id} 确认`;
        document.getElementById('confirmBtn').onclick = async () => {
            const input = document.getElementById('confirmInput').value.trim();
            if (input !== id) { showStatus('标识名称不匹配,已跳过此实例', 'warning'); closeModal('confirmModal'); processDeleteQueue(); return; }
            const deleteFiles = document.getElementById('confirmDeleteFiles')?.checked || false;
            const resp = await fetch('/api/instances/delete', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ id, deleteFiles: false })
            }).then(r => r.json());
            showStatus(resp.message, resp.success ? 'success' : 'danger');
            closeModal('confirmModal');
            processDeleteQueue();
        };
        openModal('confirmModal');
        document.getElementById('confirmInput').focus();
    }

    // ================================================================
    // === 实例创建向导 (对应 RtCli .guide 能力) ===
    // ================================================================
    let iw = { step: 1, types: [], type: null, versions: [], allVersions: [], version: '', loading: false };

    async function openInstanceWizard() {
        iw = { step: 1, types: [], type: null, versions: [], allVersions: [], version: '', loading: false };
        openModal('instanceWizardModal');
        iwRender();
        // 加载服务端类型列表
        const resp = await fetch('/api/instances/wizard/types').then(r => r.json()).catch(() => ({ success: false }));
        if (resp.success) { iw.types = resp.types || []; iwRender(); }
        else if (iw.step === 1) {
            document.getElementById('iwBody').innerHTML =
                `<div class="text-danger small p-2">${escapeHtml(resp.message || '获取服务端类型列表失败,可直接跳过使用手动配置')}</div>
                 <button class="btn btn-sm btn-outline-secondary mt-2" onclick="iwSelectType(null)">跳过 (我已有服务端文件)</button>`;
        }
    }

    function iwRender() {
        // 步骤指示器
        document.querySelectorAll('#iwStepsBar .wizard-step').forEach(el => {
            el.classList.toggle('active', parseInt(el.dataset.step) <= iw.step);
        });
        document.getElementById('iwPrevBtn').style.visibility = iw.step > 1 ? '' : 'hidden';
        const nextBtn = document.getElementById('iwNextBtn');
        nextBtn.textContent = iw.step === 4 ? '✓ 创建实例' : '下一步 →';
        const body = document.getElementById('iwBody');
        if (iw.step === 1) body.innerHTML = iwRenderStep1();
        else if (iw.step === 2) body.innerHTML = iwRenderStep2();
        else if (iw.step === 3) body.innerHTML = iwRenderStep3();
        else body.innerHTML = iwRenderStep4();
    }

    function iwRenderStep1() {
        if (iw.loading) return '<div class="text-muted p-4 text-center"><span class="spinner-border spinner-border-sm me-2"></span>正在获取服务端类型列表...</div>';
        if (iw.types.length === 0) return '<div class="text-muted p-4 text-center">暂无类型数据</div>';
        const cards = iw.types.map((t, idx) => `
            <div class="wizard-type-card ${iw.type === t ? 'selected' : ''}" onclick="iwSelectType(${idx})">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>${escapeHtml(t.name)}</strong>
                    ${t.downloadable ? '<span class="badge bg-success">可下载</span>' : '<span class="badge bg-secondary">手动下载</span>'}
                </div>
                ${!t.downloadable && t.website ? `<small class="text-muted d-block mt-1 wizard-url">需手动下载: ${escapeHtml(t.website)}</small>` : ''}
            </div>`).join('');
        return `
            <p class="small text-muted mb-2">选择要使用的 Minecraft 服务端类型(与 RtCli <code>.guide</code> 引导一致):</p>
            <div class="wizard-type-grid">${cards}</div>
            <div class="wizard-type-card mt-2 ${iw.type === null ? 'selected' : ''}" onclick="iwSelectType(null)">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>跳过 (我已有服务端文件)</strong>
                    <span class="badge bg-info">手动</span>
                </div>
                <small class="text-muted d-block mt-1">直接配置实例, 不自动下载服务端</small>
            </div>`;
    }

    function iwSelectType(idx) {
        iw.type = idx === null ? null : iw.types[idx];
        iw.version = '';
        iwRender();
    }

    function iwRenderStep2() {
        if (iw.type === null || !iw.type.downloadable) {
            if (iw.type && iw.type.website) {
                return `
                    <p class="small">${escapeHtml(iw.type.name)} 需要手动下载:</p>
                    <div class="alert alert-warning py-2 small wizard-url">
                        请从 <a href="${escapeHtml(iw.type.website)}" target="_blank" class="text-info wizard-url">${escapeHtml(iw.type.website)}</a>
                        下载 jar 文件, 并在下一步的工作目录中放置 ${escapeHtml(iw.type.defaultJar || '服务端 jar')}。
                    </div>`;
            }
            return '<div class="alert alert-info py-2 small">已选择跳过下载, 请直接进入下一步配置实例。</div>';
        }
        if (iw.loading) return '<div class="text-muted p-4 text-center"><span class="spinner-border spinner-border-sm me-2"></span>正在获取版本列表...</div>';
        if (iw.versions.length === 0) return '<div class="text-muted p-4 text-center">暂无版本数据</div>';
        const mk = (v, label) => `
            <button type="button" class="wizard-version-btn ${iw.version === v ? 'selected' : ''}" onclick="iwSetVersion('${escapeHtml(v)}')">
                ${escapeHtml(label || v)} ${iw.version === v ? '✓' : ''}
            </button>`;
        let html = `<p class="small text-muted mb-2">选择 ${escapeHtml(iw.type.name)} 版本:</p>`;
        html += `<div class="d-flex gap-1 flex-wrap mb-2">${mk(iw.versions[0], '最新版 ' + iw.versions[0])}`;
        iw.versions.slice(1).forEach(v => html += mk(v));
        html += '</div>';
        if (iw.allVersions.length > iw.versions.length) {
            html += `<details class="mt-2"><summary class="small text-muted" style="cursor:pointer;">显示全部 ${iw.allVersions.length} 个版本</summary>
                <div class="d-flex gap-1 flex-wrap mt-2" style="max-height:220px;overflow-y:auto;">
                    ${iw.allVersions.filter(v => !iw.versions.includes(v)).map(v => mk(v)).join('')}
                </div></details>`;
        }
        return html;
    }

    async function iwLoadVersions() {
        if (!iw.type || !iw.type.downloadable) return;
        iw.loading = true; iw.versions = []; iw.allVersions = []; iwRender();
        const resp = await fetch(`/api/instances/wizard/versions?typeKey=${encodeURIComponent(iw.type.typeKey)}`).then(r => r.json()).catch(() => ({ success: false }));
        iw.loading = false;
        if (resp.success) {
            iw.versions = resp.versions || [];
            iw.allVersions = resp.allVersions || resp.versions || [];
            if (iw.versions.length > 0) iw.version = iw.versions[0];
        } else {
            showStatus(resp.message || '获取版本列表失败', 'danger');
        }
        iwRender();
    }

    function iwSetVersion(v) { iw.version = v; iwRender(); }

    function iwRenderStep3() {
        const jar = iw.type && iw.type.downloadable && iw.jarName ? iw.jarName : (iw.type ? (iw.type.defaultJar || 'server.jar') : 'server.jar');
        return `
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label class="form-label small">实例标识 *</label>
                    <input type="text" class="form-control form-control-sm" id="iw_identifier" placeholder="如: survival" oninput="iwSyncWorkPath()" value="${escapeHtml(iw.identifier || '')}" />
                    <small class="text-muted">唯一标识, 用于 config.yml server_list 的键</small>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">显示名称</label>
                    <input type="text" class="form-control form-control-sm" id="iw_name" placeholder="如: 生存服" value="${escapeHtml(iw.name || '')}" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">工作目录 *</label>
                <input type="text" class="form-control form-control-sm" id="iw_workPath" placeholder="如: servers/survival (留空自动生成)" value="${escapeHtml(iw.workPath || '')}" oninput="this.dataset.touched='1'" />
                <small class="text-muted">${iw.type && iw.type.downloadable ? '服务端 jar 将下载到此目录' : '服务端 jar 文件所在目录'}</small>
            </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label class="form-label small">Java 路径</label>
                    <input type="text" class="form-control form-control-sm" id="iw_javaPath" placeholder="留空用默认 java" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">分析模式</label>
                    <select class="form-select form-select-sm" id="iw_analyzerMode">
                        <option value="RM">RM - 管理(推荐)</option>
                        <option value="RUN">RUN - 子进程</option>
                        <option value="RR">RR - 子进程+Rcon</option>
                        <option value="RCON">RCON - 纯远程</option>
                    </select>
                    <small class="text-muted">RM 可用服务端管理协议(MC 1.21.9+); RCON 不启动服务端</small>
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">启动参数</label>
                <textarea class="form-control form-control-sm" id="iw_runFlags" rows="2" placeholder="-Xms1024M -Xmx1024M -jar ${escapeHtml(jar)} --nogui"></textarea>
                <small class="text-muted">留空自动生成: -Xms1024M -Xmx1024M -jar ${escapeHtml(jar)} --nogui</small>
            </div>`;
    }

    function iwSyncWorkPath() {
        const id = document.getElementById('iw_identifier')?.value.trim() || '';
        iw.identifier = id;
        iw.workPath = id ? `servers/${id}` : '';
        const wp = document.getElementById('iw_workPath');
        if (wp && !wp.dataset.touched) wp.value = iw.workPath;
    }

    function iwRenderStep4() {
        const id = iw.identifier || document.getElementById('iw_identifier')?.value || '';
        const t = iw.type;
        return `
            <div class="alert ${t && t.downloadable ? 'alert-info' : 'alert-warning'} py-2 small mb-3">
                ${t && t.downloadable
                    ? `将下载 <strong>${escapeHtml(t.name)}</strong> ${iw.version ? escapeHtml(iw.version) : '最新版'} 到 <code>${escapeHtml(iw.workPath || 'servers/' + id)}</code>, 然后创建实例。`
                    : '不会自动下载服务端, 创建后请将 jar 文件放入工作目录。'}
            </div>
            <table class="table table-sm small mb-0">
                <tbody>
                    <tr><td class="text-muted" style="width:120px;">实例标识</td><td>${escapeHtml(id)}</td></tr>
                    <tr><td class="text-muted">服务端类型</td><td>${t ? escapeHtml(t.name) : '跳过 (手动配置)'}</td></tr>
                    <tr><td class="text-muted">版本</td><td>${t && t.downloadable ? escapeHtml(iw.version || '最新版') : '-'}</td></tr>
                    <tr><td class="text-muted">工作目录</td><td>${escapeHtml(iw.workPath || 'servers/' + id)}</td></tr>
                </tbody>
            </table>`;
    }

    async function iwNext() {
        if (iw.step === 1) {
            if (iw.loading) { showStatus('正在加载, 请稍候', 'info'); return; }
            if (iw.type === undefined) { showStatus('请选择服务端类型', 'warning'); return; }
            iw.step = 2;
            iwRender();
            if (iw.type && iw.type.downloadable) await iwLoadVersions();
            return;
        }
        if (iw.step === 2) {
            if (iw.type && iw.type.downloadable && !iw.version) { showStatus('请选择版本', 'warning'); return; }
            iw.step = 3;
            iwRender();
            // 自动预填
            setTimeout(() => { iwSyncWorkPath(); }, 0);
            return;
        }
        if (iw.step === 3) {
            iw.identifier = document.getElementById('iw_identifier').value.trim();
            iw.name = document.getElementById('iw_name').value.trim();
            iw.workPath = document.getElementById('iw_workPath').value.trim() || (iw.identifier ? `servers/${iw.identifier}` : '');
            iw.javaPath = document.getElementById('iw_javaPath').value.trim();
            iw.runFlags = document.getElementById('iw_runFlags').value.trim();
            iw.analyzerMode = document.getElementById('iw_analyzerMode').value;
            if (!iw.identifier) { showStatus('请输入实例标识', 'warning'); return; }
            if (!iw.workPath) { showStatus('请输入工作目录', 'warning'); return; }
            iw.step = 4;
            iwRender();
            return;
        }
        // step 4: 执行创建
        await iwFinish();
    }

    function iwPrev() {
        if (iw.step > 1) { iw.step--; iwRender(); }
    }

    async function iwFinish() {
        const nextBtn = document.getElementById('iwNextBtn');
        nextBtn.disabled = true;
        try {
            // 1. 下载服务端 (如需要)
            if (iw.type && iw.type.downloadable) {
                nextBtn.textContent = '⬇ 正在下载服务端...';
                const dResp = await fetch('/api/instances/wizard/download', {
                    method: 'POST', headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({ typeKey: iw.type.typeKey, version: iw.version, workPath: iw.workPath })
                }).then(r => r.json());
                if (!dResp.success) {
                    showStatus(dResp.message || '服务端下载失败', 'danger');
                    nextBtn.disabled = false; nextBtn.textContent = '✓ 创建实例';
                    return;
                }
                iw.jarName = dResp.jarName;
                showStatus(`服务端已下载: ${dResp.jarName}`, 'success');
            }
            // 2. 创建实例
            nextBtn.textContent = '✓ 正在创建实例...';
            const jar = iw.jarName || (iw.type ? (iw.type.defaultJar || 'server.jar') : 'server.jar');
            const runFlags = iw.runFlags || `-Xms1024M -Xmx1024M -jar ${jar} --nogui`;
            const resp = await fetch('/api/instances/create', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({
                    identifier: iw.identifier, name: iw.name,
                    workPath: iw.workPath, javaPath: iw.javaPath,
                    runFlags, analyzerMode: iw.analyzerMode
                })
            }).then(r => r.json());
            showStatus(resp.message, resp.success ? 'success' : 'danger');
            if (resp.success) { closeModal('instanceWizardModal'); loadInstances(); }
        } catch (e) {
            showStatus('创建失败: ' + e.message, 'danger');
        } finally {
            nextBtn.disabled = false;
            if (document.getElementById('instanceWizardModal').style.display !== 'none') nextBtn.textContent = '✓ 创建实例';
        }
    }

    // ================================================================
    // === 群组服务器构建向导 (对应 RtCli .group build 能力) ===
    // ================================================================
    let gw = { step: 1, groupName: '', members: [], proxyType: 'velocity', proxyId: '', proxyPort: 25565,
               autoPorts: true, portStart: 25566, portEnd: 25570, onlineMode: true, lobby: '' };

    function openGroupWizard(existingGroupId) {
        gw = { step: 1, groupName: '', members: [], proxyType: 'velocity', proxyId: '', proxyPort: 25565,
               autoPorts: true, portStart: 25566, portEnd: 25570, onlineMode: true, lobby: '' };
        if (existingGroupId) {
            // 从已有群组进入: 预填群组名与成员
            const g = allGroups.find(x => x.id === existingGroupId);
            if (g) {
                gw.groupName = g.name;
                gw.members = [...(g.memberIds || [])];
                gw.proxyId = 'proxy';
                document.getElementById('gwTitle').textContent = `为群组「${g.name}」构建代理服务器`;
            }
        } else {
            document.getElementById('gwTitle').textContent = '群组服务器构建向导';
        }
        openModal('groupWizardModal');
        gwRender();
    }

    function gwRender() {
        document.querySelectorAll('#gwStepsBar .wizard-step').forEach(el => {
            el.classList.toggle('active', parseInt(el.dataset.step) <= gw.step);
        });
        document.getElementById('gwPrevBtn').style.visibility = gw.step > 1 ? '' : 'hidden';
        const nextBtn = document.getElementById('gwNextBtn');
        nextBtn.textContent = gw.step === 5 ? '⚡ 开始构建' : '下一步 →';
        const body = document.getElementById('gwBody');
        if (gw.step === 1) body.innerHTML = gwRenderStep1();
        else if (gw.step === 2) body.innerHTML = gwRenderStep2();
        else if (gw.step === 3) body.innerHTML = gwRenderStep3();
        else if (gw.step === 4) body.innerHTML = gwRenderStep4();
        else body.innerHTML = gwRenderStep5();
    }

    function gwRenderStep1() {
        return `
            <p class="small text-muted mb-2">输入群组名称, 向导将自动完成: 群组创建 → 代理服务端 → 端口分配 → 代理配置生成。</p>
            <label class="form-label small">群组名称 *</label>
            <input type="text" class="form-control form-control-sm" id="gw_groupName" placeholder="如: 主群组"
                   value="${escapeHtml(gw.groupName)}" oninput="gw.groupName = this.value" />
            <div class="alert alert-info py-2 small mt-3 mb-0">
                <strong>提示:</strong> 此向导对应 RtCli 的 <code>.group build</code> 命令, 构建完成后可在实例列表中启动代理与子服务器。
            </div>`;
    }

    function gwRenderStep2() {
        const available = allInstances.filter(i => !gw.members.includes(i.id));
        const selected = allInstances.filter(i => gw.members.includes(i.id));
        return `
            <p class="small text-muted mb-2">选择要加入群组的子服务器 (已选 ${selected.length} 个):</p>
            <div class="border rounded p-2 mb-2" style="max-height:220px;overflow-y:auto;">
                ${allInstances.length === 0 ? '<div class="text-muted small">暂无实例, 可先创建实例后再构建群组</div>' :
                    allInstances.map(inst => `
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="gwm_${escapeHtml(inst.id)}"
                                   ${gw.members.includes(inst.id) ? 'checked' : ''} onchange="gwToggleMember('${escapeHtml(inst.id)}', this.checked)" />
                            <label class="form-check-label" for="gwm_${escapeHtml(inst.id)}">
                                ${escapeHtml(inst.name)} <small class="text-muted">(${escapeHtml(inst.id)})</small>
                                ${inst.groupId ? '<span class="badge bg-warning text-dark ms-1">已在其他群组</span>' : ''}
                            </label>
                        </div>`).join('')}
            </div>
            ${selected.length > 0 ? `<small class="text-info">已选: ${selected.map(m => escapeHtml(m.id)).join(', ')}</small>` : '<small class="text-muted">可以不选, 之后通过群组「+ 添加」加入</small>'}`;
    }

    function gwToggleMember(id, checked) {
        if (checked) { if (!gw.members.includes(id)) gw.members.push(id); }
        else { gw.members = gw.members.filter(m => m !== id); }
    }

    function gwRenderStep3() {
        const proxies = [
            { key: 'velocity', name: 'Velocity', desc: '推荐 · 高性能现代代理, 自动下载', badge: 'success' },
            { key: 'bungeecord', name: 'BungeeCord', desc: '老牌代理, 需手动下载 jar', badge: 'secondary' },
            { key: 'manual', name: '手动配置', desc: '使用已有代理端, 不自动下载', badge: 'info' },
        ];
        return `
            <p class="small text-muted mb-2">选择代理服务端类型:</p>
            <div class="wizard-type-grid mb-3">
                ${proxies.map(p => `
                    <div class="wizard-type-card ${gw.proxyType === p.key ? 'selected' : ''}" onclick="gwSetProxy('${p.key}')">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>${p.name}</strong><span class="badge bg-${p.badge}">${p.key === 'velocity' ? '推荐' : (p.key === 'bungeecord' ? '手动下载' : '已有')}</span>
                        </div>
                        <small class="text-muted d-block mt-1">${p.desc}</small>
                    </div>`).join('')}
            </div>
            <div class="row">
                <div class="col-md-7 mb-2">
                    <label class="form-label small">代理实例标识 * (英文)</label>
                    <input type="text" class="form-control form-control-sm" id="gw_proxyId" placeholder="如: proxy"
                           value="${escapeHtml(gw.proxyId)}" oninput="gw.proxyId = this.value" />
                </div>
                <div class="col-md-5 mb-2">
                    <label class="form-label small">玩家连接端口</label>
                    <input type="number" class="form-control form-control-sm" id="gw_proxyPort" min="1" max="65535"
                           value="${gw.proxyPort}" oninput="gw.proxyPort = parseInt(this.value) || 25565" />
                </div>
            </div>
            <small class="text-muted">玩家通过此端口连接群组服; 子服务器仅监听本机, 由代理转发。</small>`;
    }

    function gwSetProxy(key) { gw.proxyType = key; gwRender(); }

    function gwRenderStep4() {
        return `
            <p class="small text-muted mb-2">子服务器端口分配方式:</p>
            <div class="form-check mb-2">
                <input type="radio" class="form-check-input" id="gw_autoPorts" name="gwPorts" ${gw.autoPorts ? 'checked' : ''} onchange="gw.autoPorts = true; gwRender()" />
                <label class="form-check-label small" for="gw_autoPorts">
                    <strong>自动分配端口</strong> <span class="text-muted">(推荐, 按范围依次分配并写入 server.properties)</span>
                </label>
            </div>
            ${gw.autoPorts ? `
            <div class="row mb-3 ms-4">
                <div class="col-5">
                    <label class="form-label small mb-1">范围起</label>
                    <input type="number" class="form-control form-control-sm" id="gw_portStart" min="1" max="65535"
                           value="${gw.portStart}" oninput="gw.portStart = parseInt(this.value) || 25566" />
                </div>
                <div class="col-5">
                    <label class="form-label small mb-1">范围止</label>
                    <input type="number" class="form-control form-control-sm" id="gw_portEnd" min="1" max="65535"
                           value="${gw.portEnd}" oninput="gw.portEnd = parseInt(this.value) || 25570" />
                </div>
            </div>` : ''}
            <div class="form-check">
                <input type="radio" class="form-check-input" id="gw_manualPorts" name="gwPorts" ${!gw.autoPorts ? 'checked' : ''} onchange="gw.autoPorts = false; gwRender()" />
                <label class="form-check-label small" for="gw_manualPorts">
                    <strong>使用服务器现有端口</strong> <span class="text-muted">(读取各子服务器 server.properties, 冲突自动递增)</span>
                </label>
            </div>`;
    }

    function gwRenderStep5() {
        const lobbyOptions = gw.members.length > 0
            ? gw.members.map(m => `<option value="${escapeHtml(m)}" ${gw.lobby === m ? 'selected' : ''}>${escapeHtml(m)}</option>`).join('')
            : '<option value="">(无成员)</option>';
        return `
            <div class="mb-3">
                <label class="form-label small mb-2">验证模式:</label>
                <div class="d-flex gap-2">
                    <div class="wizard-type-card flex-fill ${gw.onlineMode ? 'selected' : ''}" onclick="gw.onlineMode = true; gwRender()">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>在线模式</strong><span class="badge bg-success">正版验证</span>
                        </div>
                        <small class="text-muted d-block mt-1">代理端验证正版账号</small>
                    </div>
                    <div class="wizard-type-card flex-fill ${!gw.onlineMode ? 'selected' : ''}" onclick="gw.onlineMode = false; gwRender()">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>离线模式</strong><span class="badge bg-warning text-dark">兼容盗版</span>
                        </div>
                        <small class="text-muted d-block mt-1">建议安装防盗号插件 (如 AuthMe)</small>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small">玩家首次进入的服务器</label>
                <select class="form-select form-select-sm" id="gw_lobby" onchange="gw.lobby = this.value">
                    ${gw.members.length > 0 ? `<option value="">默认 (${escapeHtml(gw.members[0])})</option>` : ''}
                    ${lobbyOptions}
                </select>
            </div>
            <div class="alert alert-secondary py-2 small mb-0">
                <strong>构建摘要:</strong> 群组「${escapeHtml(gw.groupName)}」 · 成员 ${gw.members.length} 个 · 代理 ${escapeHtml(gw.proxyId || '(待填)')} (${escapeHtml(gw.proxyType)})
                · 端口 ${gw.proxyPort} · ${gw.autoPorts ? `自动分配 ${gw.portStart}-${gw.portEnd}` : '使用现有端口'} · ${gw.onlineMode ? '在线' : '离线'}模式
            </div>`;
    }

    async function gwNext() {
        if (gw.step === 1) {
            gw.groupName = document.getElementById('gw_groupName').value.trim();
            if (!gw.groupName) { showStatus('请输入群组名称', 'warning'); return; }
            if (!gw.proxyId) gw.proxyId = 'proxy';
            gw.step = 2; gwRender(); return;
        }
        if (gw.step === 2) { gw.step = 3; gwRender(); return; }
        if (gw.step === 3) {
            gw.proxyId = document.getElementById('gw_proxyId').value.trim();
            gw.proxyPort = parseInt(document.getElementById('gw_proxyPort').value) || 25565;
            if (!gw.proxyId) { showStatus('请输入代理实例标识', 'warning'); return; }
            if (allInstances.some(i => i.id === gw.proxyId)) { showStatus(`标识 '${gw.proxyId}' 已被占用`, 'warning'); return; }
            gw.step = 4; gwRender(); return;
        }
        if (gw.step === 4) { gw.step = 5; gwRender(); return; }
        await gwFinish();
    }

    function gwPrev() {
        if (gw.step > 1) { gw.step--; gwRender(); }
    }

    async function gwFinish() {
        const nextBtn = document.getElementById('gwNextBtn');
        nextBtn.disabled = true;
        nextBtn.textContent = gw.proxyType === 'velocity' ? '⬇ 正在下载代理端并构建...' : '⚡ 正在构建群组...';
        try {
            const resp = await fetch('/api/instances/wizard/group-build', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({
                    groupName: gw.groupName, memberIds: gw.members,
                    proxyType: gw.proxyType, proxyId: gw.proxyId, proxyPort: gw.proxyPort,
                    autoPorts: gw.autoPorts, portRangeStart: gw.portStart, portRangeEnd: gw.portEnd,
                    onlineMode: gw.onlineMode, lobbyServer: gw.lobby
                })
            }).then(r => r.json());
            if (resp.success) {
                const ports = (resp.serverPorts || []).map(p => `${escapeHtml(p.id)} → 127.0.0.1:${p.port}`).join('<br/>');
                document.getElementById('gwBody').innerHTML = `
                    <div class="alert alert-success py-2 small">${escapeHtml(resp.message)}</div>
                    <table class="table table-sm small">
                        <tbody>
                            <tr><td class="text-muted" style="width:130px;">群组 ID</td><td>${escapeHtml(resp.groupId)}</td></tr>
                            <tr><td class="text-muted">代理实例</td><td>${escapeHtml(resp.proxyInstanceId)}</td></tr>
                            <tr><td class="text-muted">玩家连接端口</td><td>${gw.proxyPort}</td></tr>
                            <tr><td class="text-muted">端口分配</td><td>${ports || '无子服务器'}</td></tr>
                        </tbody>
                    </table>
                    <div class="alert alert-info py-2 small mb-0">代理配置已生成, 可在实例列表启动代理与子服务器。${gw.proxyType === 'bungeecord' ? ' BungeeCord 需手动下载 jar 放入代理目录后才能启动。' : ''}</div>`;
                nextBtn.textContent = '完成';
                nextBtn.onclick = () => { closeModal('groupWizardModal'); loadInstances(); nextBtn.onclick = gwNext; };
                loadInstances();
                showStatus(resp.message, 'success');
            } else {
                showStatus(resp.message || '构建失败', 'danger');
                nextBtn.disabled = false;
                nextBtn.textContent = '⚡ 开始构建';
            }
        } catch (e) {
            showStatus('构建失败: ' + e.message, 'danger');
            nextBtn.disabled = false;
            nextBtn.textContent = '⚡ 开始构建';
        }
    }

    // === 群组操作 ===
    async function groupAction(groupId, action) {
        const actionName = { start:'启动', stop:'停止', restart:'重启' }[action] || action;
        const group = allGroups.find(g => g.id === groupId);
        if (!await confirmDialog(`群组${actionName}`, `确定对群组「${group?.name}」的全部 ${group?.memberIds?.length || 0} 个成员执行「${actionName}」?`)) return;
        const resp = await fetch('/api/instances/group/action', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ action, groupId })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadInstances();
    }

    async function disbandGroup(groupId) {
        const group = allGroups.find(g => g.id === groupId);
        if (!await confirmDialog('解散群组', `确定解散群组「${group?.name}」?成员将变为独立实例,服务器文件不受影响。`)) return;
        const resp = await fetch('/api/instances/group/delete', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ groupId })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadInstances();
    }

    async function showAddMemberModal(groupId) {
        const group = allGroups.find(g => g.id === groupId);
        const available = allInstances.filter(i => i.groupId !== groupId);
        if (available.length === 0) { showStatus('没有可添加的实例', 'info'); return; }

        const container = document.createElement('div');
        container.innerHTML = `<h5>添加成员到「${escapeHtml(group.name)}」</h5>`;
        available.forEach(inst => {
            const div = document.createElement('div');
            div.className = 'form-check';
            div.innerHTML = `<input type="checkbox" class="form-check-input" value="${escapeHtml(inst.id)}" id="am_${escapeHtml(inst.id)}" />
                <label class="form-check-label" for="am_${escapeHtml(inst.id)}">${escapeHtml(inst.name)} <small class="text-muted">(${escapeHtml(inst.id)})</small></label>`;
            container.appendChild(div);
        });
        const btnRow = document.createElement('div');
        btnRow.className = 'text-end mt-3';
        btnRow.innerHTML = `<button class="btn btn-sm btn-secondary" onclick="closeModal('manageModal')">取消</button>
            <button class="btn btn-sm btn-primary" onclick="addMembers('${groupId}')">添加</button>`;
        container.appendChild(btnRow);
        document.getElementById('manageContent').innerHTML = '';
        document.getElementById('manageContent').appendChild(container);
        document.getElementById('manageTitle').textContent = '添加成员';
        openModal('manageModal');
    }

    async function addMembers(groupId) {
        const memberIds = Array.from(document.querySelectorAll('#manageContent input:checked')).map(cb => cb.value);
        if (memberIds.length === 0) { showStatus('请选择成员', 'warning'); return; }
        const resp = await fetch('/api/instances/group/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ operation: 'add', groupId, memberIds })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) { closeModal('manageModal'); loadInstances(); }
    }

    async function showManageGroupModal(groupId) {
        const group = allGroups.find(g => g.id === groupId);
        const members = allInstances.filter(i => i.groupId === groupId);
        const container = document.createElement('div');
        container.innerHTML = `
            <div class="mb-3">
                <label class="form-label small">群组名称</label>
                <input type="text" class="form-control form-control-sm" id="mg_name" value="${escapeHtml(group.name)}" />
            </div>
            <div class="mb-3">
                <label class="form-label small">成员列表 (${members.length})</label>
                <div class="border rounded p-2" style="max-height:200px;overflow-y:auto;">
                    ${members.length === 0 ? '<div class="text-muted small">无成员</div>' :
                        members.map(m => `<div class="d-flex justify-content-between align-items-center py-1">
                            <span>${escapeHtml(m.name)} <small class="text-muted">(${escapeHtml(m.id)})</small></span>
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeMember('${groupId}','${escapeHtml(m.id)}')">移除</button>
                        </div>`).join('')}
                </div>
            </div>
            <div class="text-end">
                <button class="btn btn-sm btn-primary" onclick="renameGroup('${groupId}')">重命名</button>
            </div>
        `;
        document.getElementById('manageContent').innerHTML = '';
        document.getElementById('manageContent').appendChild(container);
        document.getElementById('manageTitle').textContent = '管理群组';
        openModal('manageModal');
    }

    async function renameGroup(groupId) {
        const name = document.getElementById('mg_name').value.trim();
        if (!name) { showStatus('名称不能为空', 'warning'); return; }
        const resp = await fetch('/api/instances/group/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ operation: 'rename', groupId, name })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) { closeModal('manageModal'); loadInstances(); }
    }

    async function removeMember(groupId, memberId) {
        const resp = await fetch('/api/instances/group/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ operation: 'remove', groupId, memberIds: [memberId] })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) { closeModal('manageModal'); loadInstances(); }
    }

    // === 实例管理(详情+备份+配置) ===
    async function showManageModal(id) {
        const resp = await fetch(`/api/instances/detail?id=${encodeURIComponent(id)}`).then(r => r.json());
        if (!resp.success) { showStatus(resp.message, 'danger'); return; }
        const inst = resp.instance;
        const backups = resp.backups || [];

        const container = document.createElement('div');
        container.innerHTML = `
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label small">显示名称</label>
                    <input type="text" class="form-control form-control-sm" id="mg_inst_name" value="${escapeHtml(inst.name)}" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small">分析模式</label>
                    <select class="form-select form-select-sm" id="mg_inst_mode">
                        ${(() => {
                            // 与 RtCli Analyzer 的模式规范一致: RM/RUN/RR/RCON(旧名自动映射)
                            const legacy = { MANAGEMENT:'RM', RUN:'RUN', RCON:'RR', ONLYRCON:'RCON' };
                            const cur = (inst.analyzerMode || 'RM').toUpperCase();
                            const val = legacy[cur] || cur;
                            const modes = [['RM','RM - 管理(推荐)'],['RUN','RUN - 子进程'],['RR','RR - 子进程+Rcon'],['RCON','RCON - 纯远程']];
                            if (!modes.some(m => m[0] === val)) modes.push([val, val]);
                            return modes.map(m => `<option value="${m[0]}" ${m[0]===val?'selected':''}>${m[1]}</option>`).join('');
                        })()}
                    </select>
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">工作目录</label>
                <input type="text" class="form-control form-control-sm" id="mg_inst_workPath" value="${escapeHtml(inst.workPath)}" />
            </div>
            <div class="mb-2">
                <label class="form-label small">Java 路径</label>
                <input type="text" class="form-control form-control-sm" id="mg_inst_javaPath" value="${escapeHtml(inst.javaPath)}" />
            </div>
            <div class="mb-3">
                <label class="form-label small">启动参数</label>
                <textarea class="form-control form-control-sm" id="mg_inst_runFlags" rows="2">${escapeHtml(inst.runFlags)}</textarea>
            </div>
            <div class="mb-3">
                <div class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" id="mg_inst_hidden" ${inst.hidden?'checked':''} onchange="toggleHidden('${escapeHtml(inst.id)}', this.checked)" />
                    <label class="form-check-label small" for="mg_inst_hidden">隐藏控制台消息(同步到 config.yml)</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" id="mg_inst_autoRestart" ${inst.autoRestart?'checked':''} />
                    <label class="form-check-label small" for="mg_inst_autoRestart">崩溃自动重启</label>
                </div>
            </div>
            <hr/>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">备份管理</h6>
                <button class="btn btn-sm btn-outline-success" onclick="createBackup('${escapeHtml(inst.id)}')">+ 创建备份</button>
            </div>
            <div class="border rounded" style="max-height:200px;overflow-y:auto;">
                ${backups.length === 0 ? '<div class="text-muted small p-3">暂无备份</div>' :
                    backups.map(b => `<div class="d-flex justify-content-between align-items-center border-bottom p-2">
                        <div>
                            <div class="small">${escapeHtml(b.fileName)}</div>
                            <small class="text-muted">${escapeHtml(b.createdAt)} · ${formatBytes(b.sizeBytes)}</small>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-warning" onclick="restoreBackup('${escapeHtml(inst.id)}','${escapeHtml(b.fileName)}')">恢复</button>
                            <button class="btn btn-outline-danger" onclick="deleteBackup('${escapeHtml(inst.id)}','${escapeHtml(b.fileName)}')">删除</button>
                        </div>
                    </div>`).join('')}
            </div>
            <hr/>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">日志管理</h6>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info" onclick="loadInstanceLog('${escapeHtml(inst.id)}')">查看日志</button>
                    <button class="btn btn-sm btn-outline-warning" onclick="analyzeInstanceErrors('${escapeHtml(inst.id)}')">分析错误</button>
                    <button class="btn btn-sm btn-outline-success" onclick="shareInstanceLog('${escapeHtml(inst.id)}')">分享日志</button>
                </div>
            </div>
            <div id="instanceLogArea" class="border rounded mb-2" style="max-height:300px;overflow-y:auto;background:#0d0d1a;padding:8px;font-family:Consolas,monospace;font-size:12px;line-height:1.5;display:none;">
                <div class="text-muted p-2">点击「查看日志」加载...</div>
            </div>
            <div id="instanceErrorArea" style="display:none;"></div>
            <div id="instanceAiArea" style="display:none;"></div>
            <hr/>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">快捷操作</h6>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-sm btn-outline-danger" onclick="deleteSingle('${escapeHtml(inst.id)}')">删除此实例</button>
            </div>
            <div class="text-end mt-3">
                <button class="btn btn-sm btn-primary" onclick="saveInstanceConfig('${escapeHtml(inst.id)}')">保存配置</button>
            </div>
        `;
        document.getElementById('manageContent').innerHTML = '';
        document.getElementById('manageContent').appendChild(container);
        document.getElementById('manageTitle').textContent = `管理: ${inst.name} (${inst.id})`;
        openModal('manageModal');
    }

    async function toggleHidden(id, hidden) {
        const resp = await fetch('/api/instances/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id, hidden })
        }).then(r => r.json());
        showStatus(resp.message || (resp.success ? '已更新隐藏设置' : '更新失败'), resp.success ? 'success' : 'danger');
    }

    async function saveInstanceConfig(id) {
        const payload = {
            id,
            name: document.getElementById('mg_inst_name').value,
            workPath: document.getElementById('mg_inst_workPath').value,
            javaPath: document.getElementById('mg_inst_javaPath').value,
            runFlags: document.getElementById('mg_inst_runFlags').value,
            analyzerMode: document.getElementById('mg_inst_mode').value,
            hidden: document.getElementById('mg_inst_hidden').checked,
            autoRestart: document.getElementById('mg_inst_autoRestart').checked
        };
        const resp = await fetch('/api/instances/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify(payload)
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) loadInstances();
    }

    async function createBackup(id) {
        showStatus('正在创建备份...', 'info');
        const resp = await fetch('/api/instances/backup/create', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) showManageModal(id);
    }

    async function restoreBackup(id, fileName) {
        if (!await confirmDialog('恢复备份', `确定从「${fileName}」恢复?当前文件会被自动备份。`)) return;
        showStatus('正在恢复...', 'info');
        const resp = await fetch('/api/instances/backup/restore', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id, fileName })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) showManageModal(id);
    }

    async function deleteBackup(id, fileName) {
        if (!await confirmDialog('删除备份', `确定删除备份「${fileName}」?此操作不可恢复。`)) return;
        const resp = await fetch('/api/instances/backup/delete', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id, fileName })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) showManageModal(id);
    }

    async function deleteSingle(id) {
        if (!await confirmDialog('删除实例', `确定删除实例「${id}」?config.yml 中的配置也会被移除。`)) return;
        const resp = await fetch('/api/instances/delete', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id, deleteFiles: false })
        }).then(r => r.json());
        showStatus(resp.message, resp.success ? 'success' : 'danger');
        if (resp.success) { closeModal('manageModal'); loadInstances(); }
    }

    // === 日志管理 ===
    async function loadInstanceLog(id) {
        const area = document.getElementById('instanceLogArea');
        area.style.display = '';
        area.innerHTML = '<div class="text-muted p-2">正在加载日志...</div>';
        const resp = await fetch(`/api/instances/log?id=${encodeURIComponent(id)}&maxLines=500`).then(r => r.json());
        if (!resp.success) {
            area.innerHTML = `<div class="text-danger p-2">${escapeHtml(resp.message || '加载失败')}</div>`;
            return;
        }
        const lines = (resp.content || '').split('\n');
        area.innerHTML = lines.map(line => {
            let cls = 'text-light';
            if (/ERROR|SEVERE|FATAL/i.test(line)) cls = 'text-danger';
            else if (/WARN/i.test(line)) cls = 'text-warning';
            else if (/<\/?INFO/i.test(line)) cls = 'text-info';
            return `<div class="${cls}">${escapeHtml(line) || '&nbsp;'}</div>`;
        }).join('');
        area.scrollTop = area.scrollHeight;
    }

    async function analyzeInstanceErrors(id) {
        const errArea = document.getElementById('instanceErrorArea');
        errArea.style.display = '';
        errArea.innerHTML = '<div class="text-muted p-2">正在分析错误...</div>';
        const resp = await fetch('/api/instances/errors/analyze', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id })
        }).then(r => r.json());
        if (!resp.success) {
            errArea.innerHTML = `<div class="text-danger p-2">${escapeHtml(resp.message || '分析失败')}</div>`;
            return;
        }
        const errors = resp.errors || [];
        if (errors.length === 0) {
            errArea.innerHTML = '<div class="text-success p-2">未检测到错误</div>';
            return;
        }
        errArea.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-muted">检测到 ${errors.length} 条错误</small>
                <div class="d-flex gap-1">
                    <input type="text" class="form-control form-control-sm" id="aiRangeInput" placeholder="如 1 或 1-3(空=全部)" style="width:140px;" />
                    <button class="btn btn-sm btn-primary" onclick="aiAnalyzeErrors('${escapeHtml(id)}')">AI分析</button>
                </div>
            </div>
            <div class="border rounded" style="max-height:200px;overflow-y:auto;">
                ${errors.map(e => `<div class="border-bottom p-2">
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-danger">#${e.index}</span>
                    </div>
                    <pre class="small text-muted mb-0" style="white-space:pre-wrap;">${escapeHtml(e.content)}</pre>
                </div>`).join('')}
            </div>
        `;
    }

    async function aiAnalyzeErrors(id) {
        const range = document.getElementById('aiRangeInput')?.value?.trim() || '';
        const aiArea = document.getElementById('instanceAiArea');
        aiArea.style.display = '';
        aiArea.innerHTML = '<div class="text-muted p-2">AI分析中，请耐心等待...</div>';
        const resp = await fetch('/api/instances/errors/ai', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id, range })
        }).then(r => r.json());
        if (!resp.success) {
            aiArea.innerHTML = `<div class="text-danger p-2">${escapeHtml(resp.message || 'AI分析失败')}</div>`;
            return;
        }
        aiArea.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-info">AI分析结果</small>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="navigator.clipboard.writeText(document.getElementById('aiResultText').textContent)">复制</button>
            </div>
            <div class="border rounded p-2" style="background:rgba(56,189,248,0.05);">
                <pre id="aiResultText" class="small text-light mb-0" style="white-space:pre-wrap;">${escapeHtml(resp.result)}</pre>
            </div>
        `;
    }

    async function shareInstanceLog(id) {
        showStatus('正在获取日志并上传到 mclo.gs...', 'info');
        // 先获取日志内容
        const logResp = await fetch(`/api/instances/log?id=${encodeURIComponent(id)}&maxLines=0`).then(r => r.json());
        if (!logResp.success) {
            showStatus(logResp.message || '获取日志失败', 'danger');
            return;
        }
        const content = logResp.content || '';
        if (!content.trim()) {
            showStatus('日志内容为空', 'warning');
            return;
        }
        // 上传到 mclo.gs
        const resp = await fetch('/api/instances/log/share', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ id, content })
        }).then(r => r.json());
        if (!resp.success) {
            showStatus(resp.message || '分享失败', 'danger');
            return;
        }
        // 显示分享链接
        const area = document.getElementById('instanceLogArea');
        area.style.display = '';
        area.innerHTML = `<div class="p-2">
            <div class="text-success mb-2">日志已分享到 mclo.gs:</div>
            <div class="d-flex align-items-center gap-2">
                <a href="${escapeHtml(resp.url)}" target="_blank" class="text-info">${escapeHtml(resp.url)}</a>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="navigator.clipboard.writeText('${escapeHtml(resp.url)}').then(()=>showStatus('已复制链接','success'))">复制</button>
            </div>
        </div>`;
    }

    // === 简易确认对话框(不需要输入的) ===
    function confirmDialog(title, msg) {
        return new Promise(resolve => {
            document.getElementById('confirmTitle').textContent = title;
            document.getElementById('confirmMsg').textContent = msg;
            document.getElementById('confirmInput').style.display = 'none';
            document.getElementById('confirmBtn').textContent = '确认';
            document.getElementById('confirmBtn').className = 'btn btn-sm btn-primary';
            document.getElementById('confirmBtn').onclick = () => {
                closeModal('confirmModal');
                document.getElementById('confirmInput').style.display = '';
                document.getElementById('confirmBtn').textContent = '确认删除';
                document.getElementById('confirmBtn').className = 'btn btn-sm btn-danger';
                resolve(true);
            };
            // 取消按钮
            const oldCancel = document.querySelector('#confirmModal .btn-secondary');
            oldCancel.onclick = () => {
                closeModal('confirmModal');
                document.getElementById('confirmInput').style.display = '';
                document.getElementById('confirmBtn').textContent = '确认删除';
                document.getElementById('confirmBtn').className = 'btn btn-sm btn-danger';
                resolve(false);
            };
            openModal('confirmModal');
        });
    }

    // === 初始化 ===
    loadInstances();
    // 每 10 秒刷新一次状态
    setInterval(() => { if (document.getElementById('manageModal').style.display === 'none') loadInstances(); }, 10000);
</script>

<style>
    .instance-row { background: rgba(255,255,255,0.02); transition: background 0.15s; }
    .instance-row:hover { background: rgba(56,189,248,0.08); }
    .instance-row[data-running="true"] { border-color: rgba(16,185,129,0.3) !important; }
    /* 实例行图标按钮: 固定正方形, 避免扁长 */
    .instance-icon-btn { width: 34px; height: 34px; padding: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 0.95rem; line-height: 1; }
    .instance-group-header { background: rgba(56, 189, 248, 0.12); }

    /* ===== 向导样式 ===== */
    .wizard-steps { display: flex; gap: 4px; flex-wrap: wrap; }
    .wizard-step { flex: 1; min-width: 70px; text-align: center; padding: 6px 4px; font-size: 0.78rem; color: var(--color-text-muted, #94a3b8); background: rgba(255,255,255,0.04); border-radius: 6px; border: 1px solid transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wizard-step.active { color: #fff; background: linear-gradient(135deg, rgba(56,189,248,0.35), rgba(14,165,233,0.25)); border-color: rgba(56,189,248,0.6); font-weight: 600; }
    .wizard-type-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
    .wizard-url { word-break: break-all; overflow-wrap: anywhere; }
    .wizard-type-card { padding: 10px 12px; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; background: rgba(255,255,255,0.03); cursor: pointer; transition: all 0.15s; }
    .wizard-type-card:hover { border-color: rgba(56,189,248,0.5); background: rgba(56,189,248,0.08); }
    .wizard-type-card.selected { border-color: #38bdf8; background: rgba(56,189,248,0.15); box-shadow: 0 0 0 1px rgba(56,189,248,0.4); }
    .wizard-version-btn { padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.04); color: inherit; font-size: 0.82rem; cursor: pointer; transition: all 0.15s; }
    .wizard-version-btn:hover { border-color: rgba(56,189,248,0.5); }
    .wizard-version-btn.selected { border-color: #38bdf8; background: rgba(56,189,248,0.2); color: #fff; font-weight: 600; }

    /* 亮色主题适配 */
    [data-theme="light"] .instance-row { background: rgba(0,0,0,0.02); }
    [data-theme="light"] .instance-row:hover { background: rgba(2, 132, 199, 0.08); }
    [data-theme="light"] .modal-box { background: #fff; }
    [data-theme="light"] .modal-box h5 { color: var(--accent); }
    [data-theme="light"] .instance-group-header { background: rgba(2, 132, 199, 0.1); }
    /* 亮色主题: outline 按钮 border 增强可见性 */
    [data-theme="light"] .btn-outline-info { border-color: var(--color-info); }
    [data-theme="light"] .btn-outline-warning { border-color: var(--color-warning); }
    [data-theme="light"] .btn-outline-success { border-color: var(--color-success); }
    [data-theme="light"] .btn-outline-danger { border-color: var(--color-danger); }
    /* 亮色主题: 向导 */
    [data-theme="light"] .wizard-step { background: rgba(0,0,0,0.05); color: #64748b; }
    [data-theme="light"] .wizard-step.active { color: #0c4a6e; background: rgba(14,165,233,0.18); }
    [data-theme="light"] .wizard-type-card { border-color: rgba(0,0,0,0.12); background: rgba(0,0,0,0.02); }
    [data-theme="light"] .wizard-type-card.selected { border-color: #0ea5e9; background: rgba(14,165,233,0.12); }
    [data-theme="light"] .wizard-version-btn { border-color: rgba(0,0,0,0.15); background: rgba(0,0,0,0.03); }
    [data-theme="light"] .wizard-version-btn.selected { border-color: #0ea5e9; background: rgba(14,165,233,0.18); color: #0c4a6e; }

    /* disabled 按钮在两个主题下都清晰可辨 */
    .instance-icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }
</style>
}
