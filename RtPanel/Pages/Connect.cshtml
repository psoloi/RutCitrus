@page
@model RtPanel.Pages.ConnectModel
@{
    ViewData["Title"] = "连接状态";
}

<div class="container mt-4">
    <h2>连接状态</h2>

    <div id="serverInfo" class="card bg-dark text-light border-secondary mt-3">
        <div class="card-header">服务器信息</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p>服务器名称: <strong id="infoName" class="text-info">-</strong></p>
                    <p>版本: <strong id="infoVersion">-</strong></p>
                    <p>地址: <strong id="infoHost">-</strong></p>
                </div>
                <div class="col-md-6">
                    <p>运行状态: <strong id="infoStatus">-</strong></p>
                    <p>已连接面板: <strong id="infoClients">-</strong></p>
                    <p>扩展数量: <strong id="infoExtensions">-</strong></p>
                </div>
            </div>
            <hr />
            <div class="d-flex gap-2">
                <a href="/Console" class="btn btn-primary btn-sm">前往控制台</a>
                <a href="/Config" class="btn btn-outline-secondary btn-sm">编辑配置</a>
                <button class="btn btn-outline-danger btn-sm" onclick="logout()">登出并断开</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function loadStatus() {
        try {
            const res = await fetch('/api/auth/status');
            if (res.ok) {
                const data = await res.json();
                if (data.connected) {
                    document.getElementById('infoName').textContent = data.serverName || '-';
                    document.getElementById('infoVersion').textContent = data.version || '-';
                    document.getElementById('infoHost').textContent = `${data.host}:${data.port}`;
                    document.getElementById('infoStatus').innerHTML = data.isRunning
                        ? '<span class="text-success">运行中</span>' : '<span class="text-danger">未运行</span>';
                    document.getElementById('infoClients').textContent = data.connectedClientCount;
                    document.getElementById('infoExtensions').textContent = data.extensionCount;
                } else {
                    document.getElementById('infoName').textContent = '未连接';
                }
            }
        } catch (e) { }
    }

    async function logout() {
        if (!await RtPanel.showConfirm('登出并断开', '确定要登出并断开与服务器的连接吗？')) return;
        try { await fetch('/api/auth/disconnect', { method: 'POST' }); } catch {}
        window.location.href = '/Login';
    }

    loadStatus();
    setInterval(loadStatus, 5000);
</script>
}
