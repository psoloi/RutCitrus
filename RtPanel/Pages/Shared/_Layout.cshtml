@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - RtPanel</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // 主题预先应用: 避免 FOUC(页面加载时闪烁)
        // localStorage.theme = 'light' | 'dark'(缺省视为 dark)
        try {
            var t = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>
    <script>
        // 防 CSRF：为所有非安全方法(GET/HEAD 除外)的 fetch 请求自动注入 X-CSRF-TOKEN 头
        (function () {
            var meta = document.querySelector('meta[name="csrf-token"]');
            var token = meta ? meta.getAttribute('content') : '';
            if (!window.fetch || !token) return;
            var orig = window.fetch;
            window.fetch = function (input, init) {
                init = init || {};
                var method = (init.method || (input && input.method) || 'GET').toUpperCase();
                if (method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS') {
                    var headers = new Headers(init.headers || {});
                    if (!headers.has('X-CSRF-TOKEN')) headers.set('X-CSRF-TOKEN', token);
                    init.headers = headers;
                }
                return orig.call(this, input, init);
            };
        })();
    </script>
    <style>
        .toast-container { position: fixed; top: 20px; right: 20px; z-index: 9999; }
        .custom-toast {
            min-width: 300px; max-width: 450px; padding: 14px 20px; margin-bottom: 10px;
            border-radius: 0; color: #fff; opacity: 0; transform: translateX(100%);
            transition: all 0.3s ease; display: flex; justify-content: space-between; align-items: center;
            border: 2px solid var(--btn-outline, #0c0c12);
            box-shadow: 4px 4px 0 rgba(0,0,0,0.45);
            font-family: var(--font-pixel, sans-serif);
            text-shadow: 0 1px 0 rgba(0,0,0,0.3);
        }
        .custom-toast.show { opacity: 1; transform: translateX(0); }
        .custom-toast.success { background: linear-gradient(180deg, #5ede8a, #34b968); color: #0c1a0e; }
        .custom-toast.error { background: linear-gradient(180deg, #f66b6b, #d43c3c); }
        .custom-toast.warning { background: linear-gradient(180deg, #fde047, #d9ae04); color: #1c1602; }
        .custom-toast.info { background: linear-gradient(180deg, #5ec8f9, #0ea5e9); color: #0c1220; }
        .custom-toast .close-btn { cursor: pointer; margin-left: 12px; font-size: 18px; opacity: 0.7; }
        .custom-toast .close-btn:hover { opacity: 1; }

        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(8, 8, 14, 0.72); z-index: 10000;
            display: flex; justify-content: center; align-items: center;
        }
        .modal-box {
            background: var(--bg-card, #1f1f28); border-radius: 0; padding: 24px; min-width: 360px; max-width: 500px;
            border: 2px solid var(--btn-outline, #0c0c12); outline: 1px solid var(--border-color, #3a3a49); outline-offset: -5px;
            box-shadow: 6px 6px 0 rgba(0,0,0,0.45);
        }
        .modal-box h5 {
            margin-bottom: 12px; color: var(--accent, #f97316); font-weight: 700;
            border-bottom: 2px solid var(--border-color, #3a3a49); padding-bottom: 0.5rem;
        }
        .modal-box p { margin-bottom: 20px; color: var(--text-secondary, #a8a89b); }
        .modal-box input {
            width: 100%; padding: 8px 12px; border: 2px solid var(--border-color, #3a3a49); border-radius: 0;
            margin-bottom: 16px; font-size: 14px; background-color: var(--bg-input, #16161e); color: var(--text-primary, #ecebe4);
            box-shadow: inset 2px 2px 0 rgba(0,0,0,0.25);
        }
        .modal-box input:focus { outline: none; border-color: var(--accent, #f97316); box-shadow: inset 2px 2px 0 rgba(0,0,0,0.25), 0 0 0 3px var(--accent-soft, rgba(249,115,22,0.16)); }
        .modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
    </style>
</head>
<body>
    <header class="island-header">
        <nav class="navbar navbar-expand-sm navbar-dark island-nav">
            <div class="container island-inner">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="brand-block" aria-hidden="true"></span>Rt<span class="brand-sky">Panel</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">主页</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Console">控制台</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Instances">实例</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Config">配置</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Extensions">扩展</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Settings">设置</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center island-actions">
                        <li class="nav-item me-2">
                            <span id="globalConnStatus" class="badge bg-secondary" style="font-size:0.85em;padding:6px 12px;border-radius:12px;">未连接</span>
                        </li>
                        <li class="nav-item me-2">
                            <button class="btn btn-sm btn-outline-secondary" id="themeToggleBtn"
                                    title="切换亮色/暗色主题" onclick="toggleTheme()">
                                <span id="themeIcon">🌙</span>
                            </button>
                        </li>
                        <li class="nav-item me-2 event-board-wrap">
                            <button class="btn btn-sm btn-outline-secondary event-board-btn" id="eventBoardBtn"
                                    title="事件板" onclick="event.stopPropagation(); EventBoard.toggle();">
                                <span aria-hidden="true">📋</span><span class="event-board-badge" id="eventBoardBadge" hidden>0</span>
                            </button>
                            <div class="event-board-panel" id="eventBoardPanel" hidden>
                                <div class="event-board-head">
                                    <span class="event-board-title">事件板</span>
                                    <button class="btn btn-sm btn-outline-secondary event-board-clear" onclick="EventBoard.clearAll()">清空</button>
                                </div>
                                <div class="event-board-list" id="eventBoardList"></div>
                            </div>
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-danger" onclick="logout()">登出</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div id="globalDisconnectAlert" class="alert alert-warning text-center mb-0" style="display:none;">
        与服务器的连接已断开，请<a href="/Login">重新登录</a>。
    </div>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RtPanel - RutCitrus 管理面板
        </div>
    </footer>

    <div class="toast-container" id="toastContainer"></div>
    <div id="modalContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        window.RtPanel = {
            showToast(message, type = 'info', duration = 3000) {
                const container = document.getElementById('toastContainer');
                const toast = document.createElement('div');
                toast.className = `custom-toast ${type}`;
                toast.innerHTML = `<span>${message}</span><span class="close-btn" onclick="this.parentElement.remove()">&times;</span>`;
                container.appendChild(toast);
                requestAnimationFrame(() => toast.classList.add('show'));
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, duration);
            },

            showConfirm(title, message) {
                return new Promise(resolve => {
                    const container = document.getElementById('modalContainer');
                    const overlay = document.createElement('div');
                    overlay.className = 'modal-overlay';
                    overlay.innerHTML = `
                        <div class="modal-box">
                            <h5>${title}</h5>
                            <p>${message}</p>
                            <div class="modal-actions">
                                <button class="btn btn-secondary btn-sm" id="modalCancel">取消</button>
                                <button class="btn btn-primary btn-sm" id="modalConfirm">确定</button>
                            </div>
                        </div>`;
                    container.appendChild(overlay);
                    overlay.querySelector('#modalConfirm').onclick = () => { overlay.remove(); resolve(true); };
                    overlay.querySelector('#modalCancel').onclick = () => { overlay.remove(); resolve(false); };
                    overlay.onclick = (e) => { if (e.target === overlay) { overlay.remove(); resolve(false); } };
                });
            },

            showPrompt(title, placeholder = '', defaultValue = '') {
                return new Promise(resolve => {
                    const container = document.getElementById('modalContainer');
                    const overlay = document.createElement('div');
                    overlay.className = 'modal-overlay';
                    overlay.innerHTML = `
                        <div class="modal-box">
                            <h5>${title}</h5>
                            <input type="text" id="modalInput" class="form-control form-control-sm" placeholder="${placeholder}" />
                            <div class="modal-actions">
                                <button class="btn btn-secondary btn-sm" id="modalCancel">取消</button>
                                <button class="btn btn-primary btn-sm" id="modalConfirm">确定</button>
                            </div>
                        </div>`;
                    container.appendChild(overlay);
                    const input = overlay.querySelector('#modalInput');
                    input.value = defaultValue;
                    input.focus();
                    input.select();
                    input.onkeydown = (e) => { if (e.key === 'Enter') { overlay.remove(); resolve(input.value); } };
                    overlay.querySelector('#modalConfirm').onclick = () => { overlay.remove(); resolve(input.value); };
                    overlay.querySelector('#modalCancel').onclick = () => { overlay.remove(); resolve(null); };
                    overlay.onclick = (e) => { if (e.target === overlay) { overlay.remove(); resolve(null); } };
                });
            },

            updateConnectionStatus(connected) {
                const badge = document.getElementById('globalConnStatus');
                const alert = document.getElementById('globalDisconnectAlert');
                const prev = badge.dataset.connected === 'true';

                if (connected) {
                    badge.textContent = '已连接';
                    badge.className = 'badge bg-success';
                    badge.style.cssText = 'font-size:0.85em;padding:6px 12px;border-radius:12px;';
                    badge.dataset.connected = 'true';
                    alert.style.display = 'none';
                } else {
                    badge.textContent = '未连接';
                    badge.className = 'badge bg-secondary';
                    badge.style.cssText = 'font-size:0.85em;padding:6px 12px;border-radius:12px;';
                    badge.dataset.connected = 'false';
                    if (prev) alert.style.display = '';
                }
            },

            async checkConnection() {
                try {
                    const r = await fetch('/api/auth/status');
                    if (r.ok) {
                        const info = await r.json();
                        this.updateConnectionStatus(info.connected);
                        return info.connected;
                    } else if (r.status === 401 || r.redirected) {
                        window.location.href = '/Login';
                    }
                } catch {}
                this.updateConnectionStatus(false);
                return false;
            }
        };

        async function logout() {
            if (!await RtPanel.showConfirm('登出', '确定要登出吗？(服务器连接将保持，其他会话不受影响)')) return;
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch {}
            window.location.href = '/Login';
        }

        // === 主题切换(亮色/暗色) ===
        function getTheme() {
            return document.documentElement.getAttribute('data-theme') || 'dark';
        }

        function applyThemeIcon() {
            const icon = document.getElementById('themeIcon');
            if (icon) icon.textContent = getTheme() === 'light' ? '☀' : '🌙';
        }

        function toggleTheme() {
            const next = getTheme() === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            applyThemeIcon();
        }

        // 初始化图标与已存主题一致
        applyThemeIcon();

        // 导航岛当前页高亮: 按路径匹配 nav-link 并标记 active
        (function () {
            var path = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/';
            document.querySelectorAll('.island-nav .navbar-nav .nav-link[href]').forEach(function (a) {
                var target = (a.getAttribute('href') || '').toLowerCase().replace(/\/+$/, '') || '/';
                var isRoot = target === '/';
                if (isRoot ? path === '/' : (path === target || path.startsWith(target + '/'))) {
                    a.classList.add('active');
                }
            });
        })();

        // === 事件板(VSCode 通知中心式下拉) ===
        window.EventBoard = {
            _timer: null,
            _events: [],
            _unread: 0,

            start() {
                // 仅登录后布局(存在事件板按钮)时启动轮询; 登录页/失败均静默
                if (this._timer || !document.getElementById('eventBoardBtn')) return;
                this.refresh();
                this._timer = setInterval(() => this.refresh(), 6000);
            },

            async refresh() {
                const btn = document.getElementById('eventBoardBtn');
                if (!btn) return;
                try {
                    const r = await fetch('/api/events/list?limit=100');
                    if (!r.ok) return;
                    const data = await r.json();
                    if (!data.success) return;
                    // 服务端按时间正序存储, 展示时最新在前
                    this._events = (data.events || []).slice().reverse();
                    this._unread = data.unreadCount || 0;
                    this.updateBadge();
                    if (this.isOpen()) this.render();
                } catch { /* 断连等静默 */ }
            },

            updateBadge() {
                const badge = document.getElementById('eventBoardBadge');
                if (!badge) return;
                if (this._unread > 0) {
                    badge.textContent = this._unread > 99 ? '99+' : this._unread;
                    badge.hidden = false;
                } else {
                    badge.hidden = true;
                }
            },

            isOpen() {
                const p = document.getElementById('eventBoardPanel');
                return !!p && !p.hidden;
            },

            async toggle() {
                const p = document.getElementById('eventBoardPanel');
                if (!p) return;
                if (p.hidden) {
                    p.hidden = false;
                    this.render();
                    this._unread = 0;
                    this.updateBadge();
                    try { await fetch('/api/events/read', { method: 'POST' }); } catch { }
                } else {
                    p.hidden = true;
                }
            },

            async clearAll() {
                if (!await RtPanel.showConfirm('清空事件板', '确定清空全部事件记录吗？')) return;
                try {
                    const r = await fetch('/api/events/clear', { method: 'POST' });
                    if (r.ok) {
                        this._events = [];
                        this._unread = 0;
                        this.updateBadge();
                        this.render();
                        RtPanel.showToast('事件板已清空', 'success');
                    }
                } catch { RtPanel.showToast('清空失败', 'error'); }
            },

            typeMeta(type) {
                switch (type) {
                    case 'started': return { icon: '🟢', cls: 'event-type-started' };
                    case 'stopped': return { icon: '⏹️', cls: 'event-type-stopped' };
                    case 'crashed': return { icon: '💥', cls: 'event-type-crashed' };
                    case 'auto_restarted': return { icon: '🔄', cls: 'event-type-auto' };
                    case 'stop_unresponsive': return { icon: '⚠️', cls: 'event-type-unresponsive' };
                    default: return { icon: '📌', cls: '' };
                }
            },

            render() {
                const list = document.getElementById('eventBoardList');
                if (!list) return;
                if (!this._events.length) {
                    list.innerHTML = '<div class="event-board-empty">暂无事件</div>';
                    return;
                }
                list.innerHTML = this._events.map(ev => {
                    const meta = this.typeMeta(ev.eventType);
                    const time = (ev.recordedAt || '').replace('T', ' ');
                    const inst = ev.instanceName
                        ? `<span class="event-instance">${this.esc(ev.instanceName)}</span><span class="event-instance-id">${this.esc(ev.instanceId)}</span>`
                        : `<span class="event-instance">${this.esc(ev.instanceId)}</span>`;
                    const forceBtn = ev.eventType === 'stop_unresponsive'
                        ? `<button class="btn btn-sm btn-danger event-force-btn" onclick="event.stopPropagation(); EventBoard.forceStop('${this.esc(ev.instanceId)}', this)">强制关闭</button>`
                        : '';
                    return `
                    <div class="event-item ${meta.cls}" data-id="${ev.id}">
                        <div class="event-item-head" onclick="EventBoard.toggleDetail(this)">
                            <span class="event-icon" aria-hidden="true">${meta.icon}</span>
                            <div class="event-main">
                                <div class="event-title-line"><span class="event-title">${this.esc(ev.title || ev.eventType)}</span>${inst}</div>
                                <div class="event-time">${this.esc(time)}</div>
                            </div>
                            <span class="event-chevron" aria-hidden="true">▸</span>
                        </div>
                        <div class="event-detail" hidden>
                            <div class="event-detail-text">${this.esc(ev.detail || '无详细信息')}</div>
                            ${forceBtn}
                        </div>
                    </div>`;
                }).join('');
            },

            toggleDetail(headEl) {
                const item = headEl.closest('.event-item');
                if (!item) return;
                const detail = item.querySelector('.event-detail');
                if (!detail) return;
                detail.hidden = !detail.hidden;
                item.classList.toggle('expanded', !detail.hidden);
            },

            async forceStop(instanceId, btn) {
                if (!await RtPanel.showConfirm('强制关闭实例',
                    `确定强制关闭实例 ${instanceId} 吗？\n服务端未响应停止指令, 强制结束进程可能丢失未保存的世界数据!`)) return;
                btn.disabled = true;
                btn.textContent = '关闭中...';
                try {
                    const r = await fetch('/api/instances/action', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'force_stop', ids: [instanceId] })
                    });
                    const d = await r.json();
                    RtPanel.showToast(d.success ? '强制关闭指令已发送' : (d.message || '强制关闭失败'), d.success ? 'success' : 'error');
                } catch {
                    RtPanel.showToast('强制关闭失败', 'error');
                }
                this.refresh();
            },

            esc(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }
        };
        EventBoard.start();

        // 点击事件板区域外时收起面板
        document.addEventListener('click', (e) => {
            const wrap = document.querySelector('.event-board-wrap');
            const panel = document.getElementById('eventBoardPanel');
            if (!wrap || !panel || panel.hidden) return;
            if (!wrap.contains(e.target)) panel.hidden = true;
        });

        setInterval(() => RtPanel.checkConnection(), 8000);
        RtPanel.checkConnection();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
