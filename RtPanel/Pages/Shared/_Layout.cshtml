@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - RtPanel</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // 主题预先应用: 避免 FOUC(页面加载时闪烁)
        // localStorage.theme = 'light' | 'dark'(缺省视为 dark)
        try {
            var t = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>
    <script>
        // 防 CSRF：为所有非安全方法(GET/HEAD 除外)的 fetch 请求自动注入 X-CSRF-TOKEN 头
        (function () {
            var meta = document.querySelector('meta[name="csrf-token"]');
            var token = meta ? meta.getAttribute('content') : '';
            if (!window.fetch || !token) return;
            var orig = window.fetch;
            window.fetch = function (input, init) {
                init = init || {};
                var method = (init.method || (input && input.method) || 'GET').toUpperCase();
                if (method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS') {
                    var headers = new Headers(init.headers || {});
                    if (!headers.has('X-CSRF-TOKEN')) headers.set('X-CSRF-TOKEN', token);
                    init.headers = headers;
                }
                return orig.call(this, input, init);
            };
        })();
    </script>
    <style>
        .toast-container { position: fixed; top: 20px; right: 20px; z-index: 9999; }
        .custom-toast {
            min-width: 300px; max-width: 450px; padding: 14px 20px; margin-bottom: 10px;
            border-radius: 8px; color: #fff; opacity: 0; transform: translateX(100%);
            transition: all 0.3s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.3);
            display: flex; justify-content: space-between; align-items: center;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .custom-toast.show { opacity: 1; transform: translateX(0); }
        .custom-toast.success { background: linear-gradient(135deg, #10b981, #059669); }
        .custom-toast.error { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .custom-toast.warning { background: linear-gradient(135deg, #f59e0b, #d97706); color: #0a1424; }
        .custom-toast.info { background: linear-gradient(135deg, #38bdf8, #0ea5e9); color: #0a1424; }
        .custom-toast .close-btn { cursor: pointer; margin-left: 12px; font-size: 18px; opacity: 0.7; }
        .custom-toast .close-btn:hover { opacity: 1; }

        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(10,20,36,0.75); z-index: 10000;
            display: flex; justify-content: center; align-items: center;
            backdrop-filter: blur(4px);
        }
        .modal-box {
            background: #122236; border-radius: 12px; padding: 24px; min-width: 360px; max-width: 500px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.6); border: 1px solid #1e3a5f;
        }
        .modal-box h5 { margin-bottom: 12px; color: #38bdf8; font-weight: 600; }
        .modal-box p { margin-bottom: 20px; color: #8b9bb4; }
        .modal-box input {
            width: 100%; padding: 8px 12px; border: 1px solid #1e3a5f; border-radius: 6px;
            margin-bottom: 16px; font-size: 14px; background-color: #0d1b2e; color: #e2eaf4;
        }
        .modal-box input:focus { outline: none; border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56,189,248,0.2); }
        .modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">RtPanel</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">主页</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Console">控制台</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Instances">实例</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Config">配置</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Extensions">扩展</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Settings">设置</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-2">
                            <span id="globalConnStatus" class="badge bg-secondary" style="font-size:0.85em;padding:6px 12px;border-radius:12px;">未连接</span>
                        </li>
                        <li class="nav-item me-2">
                            <button class="btn btn-sm btn-outline-secondary" id="themeToggleBtn"
                                    title="切换亮色/暗色主题" onclick="toggleTheme()">
                                <span id="themeIcon">🌙</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-danger" onclick="logout()">登出</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div id="globalDisconnectAlert" class="alert alert-warning text-center mb-0" style="display:none;">
        与服务器的连接已断开，请<a href="/Login">重新登录</a>。
    </div>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RtPanel - RutCitrus 管理面板
        </div>
    </footer>

    <div class="toast-container" id="toastContainer"></div>
    <div id="modalContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        window.RtPanel = {
            showToast(message, type = 'info', duration = 3000) {
                const container = document.getElementById('toastContainer');
                const toast = document.createElement('div');
                toast.className = `custom-toast ${type}`;
                toast.innerHTML = `<span>${message}</span><span class="close-btn" onclick="this.parentElement.remove()">&times;</span>`;
                container.appendChild(toast);
                requestAnimationFrame(() => toast.classList.add('show'));
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, duration);
            },

            showConfirm(title, message) {
                return new Promise(resolve => {
                    const container = document.getElementById('modalContainer');
                    const overlay = document.createElement('div');
                    overlay.className = 'modal-overlay';
                    overlay.innerHTML = `
                        <div class="modal-box">
                            <h5>${title}</h5>
                            <p>${message}</p>
                            <div class="modal-actions">
                                <button class="btn btn-secondary btn-sm" id="modalCancel">取消</button>
                                <button class="btn btn-primary btn-sm" id="modalConfirm">确定</button>
                            </div>
                        </div>`;
                    container.appendChild(overlay);
                    overlay.querySelector('#modalConfirm').onclick = () => { overlay.remove(); resolve(true); };
                    overlay.querySelector('#modalCancel').onclick = () => { overlay.remove(); resolve(false); };
                    overlay.onclick = (e) => { if (e.target === overlay) { overlay.remove(); resolve(false); } };
                });
            },

            showPrompt(title, placeholder = '') {
                return new Promise(resolve => {
                    const container = document.getElementById('modalContainer');
                    const overlay = document.createElement('div');
                    overlay.className = 'modal-overlay';
                    overlay.innerHTML = `
                        <div class="modal-box">
                            <h5>${title}</h5>
                            <input type="text" id="modalInput" placeholder="${placeholder}" />
                            <div class="modal-actions">
                                <button class="btn btn-secondary btn-sm" id="modalCancel">取消</button>
                                <button class="btn btn-primary btn-sm" id="modalConfirm">确定</button>
                            </div>
                        </div>`;
                    container.appendChild(overlay);
                    const input = overlay.querySelector('#modalInput');
                    input.focus();
                    input.onkeydown = (e) => { if (e.key === 'Enter') { overlay.remove(); resolve(input.value); } };
                    overlay.querySelector('#modalConfirm').onclick = () => { overlay.remove(); resolve(input.value); };
                    overlay.querySelector('#modalCancel').onclick = () => { overlay.remove(); resolve(null); };
                    overlay.onclick = (e) => { if (e.target === overlay) { overlay.remove(); resolve(null); } };
                });
            },

            updateConnectionStatus(connected) {
                const badge = document.getElementById('globalConnStatus');
                const alert = document.getElementById('globalDisconnectAlert');
                const prev = badge.dataset.connected === 'true';

                if (connected) {
                    badge.textContent = '已连接';
                    badge.className = 'badge bg-success';
                    badge.style.cssText = 'font-size:0.85em;padding:6px 12px;border-radius:12px;';
                    badge.dataset.connected = 'true';
                    alert.style.display = 'none';
                } else {
                    badge.textContent = '未连接';
                    badge.className = 'badge bg-secondary';
                    badge.style.cssText = 'font-size:0.85em;padding:6px 12px;border-radius:12px;';
                    badge.dataset.connected = 'false';
                    if (prev) alert.style.display = '';
                }
            },

            async checkConnection() {
                try {
                    const r = await fetch('/api/auth/status');
                    if (r.ok) {
                        const info = await r.json();
                        this.updateConnectionStatus(info.connected);
                        return info.connected;
                    } else if (r.status === 401 || r.redirected) {
                        window.location.href = '/Login';
                    }
                } catch {}
                this.updateConnectionStatus(false);
                return false;
            }
        };

        async function logout() {
            if (!await RtPanel.showConfirm('登出', '确定要登出吗？(服务器连接将保持，其他会话不受影响)')) return;
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch {}
            window.location.href = '/Login';
        }

        // === 主题切换(亮色/暗色) ===
        function getTheme() {
            return document.documentElement.getAttribute('data-theme') || 'dark';
        }

        function applyThemeIcon() {
            const icon = document.getElementById('themeIcon');
            if (icon) icon.textContent = getTheme() === 'light' ? '☀' : '🌙';
        }

        function toggleTheme() {
            const next = getTheme() === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            applyThemeIcon();
        }

        // 初始化图标与已存主题一致
        applyThemeIcon();

        setInterval(() => RtPanel.checkConnection(), 8000);
        RtPanel.checkConnection();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
